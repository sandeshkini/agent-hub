# agent-hub node config — copy to node.env and fill in for THIS machine.
# A node = a machine running its own adapters (owui-claude/opencode…) + owui-terminal, registered
# into the OWUI machine selector via registrar.py.

# --- where the OWUI hub lives (SSO-free LAN/Tailscale address of the box running OWUI) ---
HUB_REGISTER_URL=http://<hub-lan-ip>:3000/api/v1/nodes/register
NODE_HUB_TOKEN=                      # must match OWUI's NODE_HUB_TOKEN env (empty = open, LAN only)

# --- this machine's identity ---
NODE_LABEL=macbook
NODE_URL=http://192.168.0.NN:3000    # optional public/SSO URL (browser direct WS); LAN url is fine
NODE_API_URL=http://192.168.0.NN     # URL the OWUI backend calls for this node (LAN/Tailscale IP)
NODE_TOKEN=                          # bearer the OWUI backend sends to this node (if you gate it)
NODE_CAPABILITIES=terminal,claude,opencode

# --- models this machine serves (comma-separated OWUI model ids) ---
# These must match the ids OWUI exposes for this node's adapter connection. If you register the
# node's adapters as an OWUI OpenAI connection with a prefix (e.g. "mb"), list the PREFIXED ids
# here (mb.claude-sonnet-5, …). The selector displays them scoped to this machine.
# Prefixed to match what OWUI actually stores for a "mb"-prefixed connection (mb.<id>). Machine
# attribution (machineForModel) matches these against chat['models']; using UNPREFIXED ids here would
# never match the mb.* ids OWUI stores → every remote chat mis-attributes to the hub node.
NODE_MODELS=mb.claude-sonnet-5,mb.claude-opus-5,mb.opencode/glm-5.2,mb.hermes

# --- this machine's terminal server (must match an OWUI terminal-server id) ---
TERMINAL_ID=macbook
TERMINAL_NAME=macbook (shell)
TERMINAL_URL=http://192.168.0.NN:7681   # owui-terminal on this machine (OWUI backend reaches it)
TERMINAL_KEY=                            # owui-terminal bearer token

# heartbeat cadence (seconds); OWUI marks offline at 90s, evicts at 1h
HEARTBEAT_SECONDS=30
