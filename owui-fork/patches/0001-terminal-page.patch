diff --git a/backend/open_webui/routers/agent_answer.py b/backend/open_webui/routers/agent_answer.py
new file mode 100644
index 0000000..ee17b5d
--- /dev/null
+++ b/backend/open_webui/routers/agent_answer.py
@@ -0,0 +1,41 @@
+# LOCAL PATCH (agent-hub fork, E7): relay an AskUserQuestion answer from the browser to the Claude
+# adapter. The browser can't reach owui-claude:9212 directly (it's on the internal compose network),
+# so it POSTs {id, answers} here and we forward to the adapter's /answer endpoint (Bearer ADAPTER_KEY),
+# which resolves the adapter's pending canUseTool promise so Claude continues with the user's choice.
+import os
+
+import aiohttp
+from fastapi import APIRouter, Depends, Request, HTTPException
+
+from open_webui.utils.auth import get_verified_user
+
+router = APIRouter()
+
+CLAUDE_ADAPTER_URL = os.environ.get("CLAUDE_ADAPTER_URL", "http://owui-claude:9212").rstrip("/")
+ADAPTER_KEY = os.environ.get("ADAPTER_KEY", "")
+
+
+@router.post("/answer")
+async def agent_answer(request: Request, user=Depends(get_verified_user)):
+    try:
+        body = await request.json()
+    except Exception:
+        raise HTTPException(status_code=400, detail="invalid json")
+    qid = body.get("id")
+    if not qid:
+        raise HTTPException(status_code=400, detail="id required")
+    headers = {"Content-Type": "application/json"}
+    if ADAPTER_KEY:
+        headers["Authorization"] = f"Bearer {ADAPTER_KEY}"
+    try:
+        async with aiohttp.ClientSession() as s:
+            async with s.post(
+                f"{CLAUDE_ADAPTER_URL}/answer",
+                json={"id": qid, "answers": body.get("answers") or {}},
+                headers=headers,
+                timeout=aiohttp.ClientTimeout(total=15),
+            ) as r:
+                ok = r.status == 200
+                return {"ok": ok, "status": r.status}
+    except Exception as e:
+        raise HTTPException(status_code=502, detail=f"adapter unreachable: {e}")
diff --git a/backend/open_webui/routers/agent_inbox.py b/backend/open_webui/routers/agent_inbox.py
new file mode 100644
index 0000000..b9e66ff
--- /dev/null
+++ b/backend/open_webui/routers/agent_inbox.py
@@ -0,0 +1,178 @@
+# LOCAL PATCH (agent-hub fork): E2 Inbox with real-time smart summaries.
+# Returns the user's chat list (same snippet/active/unread data as OWUI's list) with a one-line
+# LLM summary attached per chat. Summaries are cached and regenerated ONLY when a chat changes
+# (updated_at), in the background (bounded concurrency), via the local Ollama model — so the /inbox
+# page can poll this cheaply and watch summaries update live. Additive: new router, own prefix.
+import asyncio
+import logging
+import os
+
+import aiohttp
+from fastapi import APIRouter, Depends, Request
+from sqlalchemy.ext.asyncio import AsyncSession
+
+from open_webui.internal.db import get_async_session
+from open_webui.models.chats import Chats
+from open_webui.routers.chats import add_active_state_to_chat_list
+from open_webui.utils.auth import get_verified_user
+
+log = logging.getLogger(__name__)
+
+router = APIRouter()
+
+# Summary provider. Default: a FREE model via the OpenCode **Zen** gateway (plain OpenAI-compatible —
+# NOT the agentic opencode adapter, which would run tools). Free cloud inference, off the local CPU.
+# SUMMARY_PROVIDER=ollama falls back to the local model. "openai" = any OpenAI-compatible base URL.
+SUMMARY_PROVIDER = os.environ.get("SUMMARY_PROVIDER", "openai").strip().lower()
+SUMMARY_ADAPTER_URL = os.environ.get("SUMMARY_ADAPTER_URL", "https://opencode.ai/zen/v1").rstrip("/")
+SUMMARY_API_KEY = os.environ.get("SUMMARY_API_KEY", os.environ.get("OPENCODE_API_KEY", ""))
+SUMMARY_MODEL = os.environ.get(
+    "INBOX_SUMMARY_MODEL",
+    "deepseek-v4-flash-free" if SUMMARY_PROVIDER != "ollama" else "llama3.2:3b",
+)
+OLLAMA_BASE_URL = os.environ.get("OLLAMA_BASE_URL", "http://ollama:11434").rstrip("/")
+
+_summaries: dict = {}          # chat_id -> {"updated_at": int, "summary": str}
+_inflight: set = set()
+_sema = asyncio.Semaphore(2)   # cap concurrent summarizations
+
+
+def _messages_text(chat_obj) -> str:
+    try:
+        data = getattr(chat_obj, "chat", None) or {}
+        hist = ((data or {}).get("history") or {}).get("messages") or {}
+        msgs = [m for m in hist.values() if isinstance(m, dict)]
+        msgs.sort(key=lambda m: m.get("timestamp") or 0)
+        lines = []
+        for m in msgs[-8:]:
+            c = (m.get("content") or "").strip()
+            if c:
+                lines.append(f"{m.get('role', '?')}: {c[:400]}")
+        return "\n".join(lines)
+    except Exception:
+        return ""
+
+
+_SUMMARY_INSTRUCTION = (
+    "You are writing a one-line label for a chat so its owner can glance at their inbox and "
+    "instantly recall what's in it. In at most 140 characters, state the SUBSTANCE of the "
+    "assistant's latest work — what it answered, found, concluded, or is currently doing — "
+    "as if telling the owner the takeaway. Prefer the assistant's most recent message. "
+    "Write it as a direct statement of content/outcome in plain language. "
+    "Do NOT narrate the exchange, and do NOT use the words 'user' or 'assistant' "
+    "(never 'user asks…', 'assistant replies…'). "
+    "Output ONLY the label line — no quotes, no preamble."
+)
+SUMMARY_MAX_CHARS = int(os.environ.get("SUMMARY_MAX_CHARS", "140"))
+
+
+def _clean_title(out: str) -> str:
+    out = (out or "").strip().strip('"').strip("`").strip()
+    # take the last non-empty line (free models sometimes prepend a preamble)
+    lines = [ln.strip() for ln in out.splitlines() if ln.strip()]
+    if lines:
+        out = lines[-1].strip().strip('"').strip()
+    if len(out) > SUMMARY_MAX_CHARS:
+        out = out[:SUMMARY_MAX_CHARS].rstrip() + "…"
+    return out
+
+
+async def _summary_via_openai(text: str):
+    body = {
+        "model": SUMMARY_MODEL,
+        "stream": False,
+        "messages": [
+            {"role": "system", "content": _SUMMARY_INSTRUCTION},
+            {"role": "user", "content": "Conversation:\n" + text[:4000]},
+        ],
+    }
+    # UA header: the OpenCode Zen gateway 403s generic clients — present as the opencode client.
+    # Harmless for OpenRouter/other OpenAI-compatible endpoints.
+    headers = {"Content-Type": "application/json", "User-Agent": os.environ.get("SUMMARY_USER_AGENT", "opencode/1.18.14")}
+    if SUMMARY_API_KEY:
+        headers["Authorization"] = f"Bearer {SUMMARY_API_KEY}"
+    async with aiohttp.ClientSession() as s:
+        async with s.post(
+            f"{SUMMARY_ADAPTER_URL}/chat/completions",
+            json=body,
+            headers=headers,
+            timeout=aiohttp.ClientTimeout(total=90),  # free model can cold-start
+        ) as r:
+            d = await r.json()
+            out = (((d.get("choices") or [{}])[0].get("message") or {}).get("content")) or ""
+            return _clean_title(out) or None
+
+
+async def _summary_via_ollama(text: str):
+    prompt = _SUMMARY_INSTRUCTION + "\n\nConversation:\n" + text[:4000] + "\n\nTitle:"
+    async with aiohttp.ClientSession() as s:
+        async with s.post(
+            f"{OLLAMA_BASE_URL}/api/generate",
+            json={"model": SUMMARY_MODEL, "prompt": prompt, "stream": False,
+                  "options": {"num_predict": 60, "temperature": 0.2}},
+            timeout=aiohttp.ClientTimeout(total=45),
+        ) as r:
+            d = await r.json()
+            return _clean_title(d.get("response") or "") or None
+
+
+async def _generate_summary(text: str):
+    try:
+        if SUMMARY_PROVIDER == "ollama":
+            return await _summary_via_ollama(text)
+        return await _summary_via_openai(text)  # openai-compatible (default: OpenCode Zen free model)
+    except Exception:
+        return None
+
+
+async def _regen(chat_id: str, updated_at: int):
+    try:
+        async with _sema:
+            chat = await Chats.get_chat_by_id(chat_id)  # manages its own session
+            if chat is None:
+                return
+            text = _messages_text(chat)
+            if not text:
+                return
+            summary = await _generate_summary(text)
+            if summary:
+                _summaries[chat_id] = {"updated_at": updated_at, "summary": summary}
+    finally:
+        _inflight.discard(chat_id)
+
+
+@router.get("/")
+async def get_inbox(
+    request: Request,
+    user=Depends(get_verified_user),
+    db: AsyncSession = Depends(get_async_session),
+):
+    chats = await Chats.get_chat_title_id_list_by_user_id(
+        user.id,
+        include_folders=True,
+        include_pinned=True,
+        sort_by="updated_at",
+        sort_dir="desc",
+        skip=0,
+        limit=40,
+        db=db,
+    )
+    try:
+        chats = await add_active_state_to_chat_list(request, chats)
+    except Exception as e:
+        # Never 500 the whole Inbox page if the active-state decoration fails — fall back to the raw list.
+        log.warning(f"[inbox] add_active_state_to_chat_list failed, using raw list: {e}")
+
+    out = []
+    for c in chats:
+        item = c.model_dump() if hasattr(c, "model_dump") else dict(c)
+        cid = item.get("id")
+        ua = item.get("updated_at")
+        cached = _summaries.get(cid)
+        # (re)generate in the background when missing or the chat changed since the cached summary
+        if (cached is None or cached.get("updated_at") != ua) and cid not in _inflight:
+            _inflight.add(cid)
+            asyncio.create_task(_regen(cid, ua))
+        item["summary"] = (cached or {}).get("summary")
+        out.append(item)
+    return out
diff --git a/backend/open_webui/routers/agent_nodes.py b/backend/open_webui/routers/agent_nodes.py
new file mode 100644
index 0000000..52453d6
--- /dev/null
+++ b/backend/open_webui/routers/agent_nodes.py
@@ -0,0 +1,119 @@
+# LOCAL PATCH (agent-hub fork): E4/E5 multi-machine node registry.
+# A faithful port of the `dispatch` hub into the OWUI backend. Each machine ("node") runs an
+# agent-hub-node bundle (adapter fleet + owui-terminal) that self-registers here on a heartbeat.
+# The registry is IN-MEMORY and stateless — rebuilt from heartbeats, exactly like dispatch:
+#   - node id = sha256(url)[:8]  (stable, deterministic)
+#   - register/heartbeat: POST /api/nodes/register  (Bearer NODE_HUB_TOKEN, machine-to-machine)
+#   - list:               GET  /api/nodes/          (browser JWT) -> nodes + computed online flag
+#   - liveness: online when last_seen <= 90s; evicted when last_seen > 1h (computed lazily on access)
+# The machine selector (frontend) reads GET /api/nodes/ to scope the model list + terminal target.
+import hashlib
+import os
+import time
+
+from fastapi import APIRouter, Depends, HTTPException, Request
+
+from open_webui.utils.auth import get_verified_user
+
+router = APIRouter()
+
+# Shared machine-to-machine secret for register/heartbeat. Registration MUTATES where the hub forwards
+# chat/terminal traffic (a rogue register could point a model's machine at an attacker-controlled host),
+# and the hub is internet-exposed — so this is FAIL-CLOSED: with no NODE_HUB_TOKEN, registration is
+# refused unless ALLOW_OPEN_NODE_REG=true is deliberately set (LAN/dev only).
+NODE_HUB_TOKEN = os.environ.get("NODE_HUB_TOKEN", "").strip()
+ALLOW_OPEN_NODE_REG = os.environ.get("ALLOW_OPEN_NODE_REG", "").strip().lower() in ("1", "true", "yes")
+
+OFFLINE_TTL = 90        # seconds without a heartbeat -> shown offline
+EVICT_TTL = 3600        # seconds without a heartbeat -> dropped from the registry
+
+# id -> node dict. Fields:
+#   id, label, url, api_url, token, capabilities[], models[], terminal(dict|None),
+#   version, registered_at, last_seen
+_nodes: dict = {}
+
+
+def _node_id(url: str) -> str:
+    return hashlib.sha256((url or "").encode()).hexdigest()[:8]
+
+
+def _bearer(request: Request) -> str:
+    h = request.headers.get("authorization", "")
+    return h[7:].strip() if h.lower().startswith("bearer ") else ""
+
+
+def _prune(now: float | None = None) -> None:
+    now = now or time.time()
+    for nid in [k for k, v in _nodes.items() if now - v.get("last_seen", 0) > EVICT_TTL]:
+        _nodes.pop(nid, None)
+
+
+def _view(n: dict, now: float) -> dict:
+    # Never leak the node token to browsers; expose an `online` flag instead of raw last_seen math.
+    return {
+        "id": n["id"],
+        "label": n.get("label") or n["id"],
+        "url": n.get("url"),
+        "api_url": n.get("api_url") or n.get("url"),
+        "capabilities": n.get("capabilities") or [],
+        "models": n.get("models") or [],
+        "terminal": n.get("terminal"),
+        "version": n.get("version"),
+        "online": (now - n.get("last_seen", 0)) <= OFFLINE_TTL,
+        "last_seen": int(n.get("last_seen", 0)),
+        "registered_at": int(n.get("registered_at", 0)),
+    }
+
+
+@router.post("/register")
+async def register_node(request: Request):
+    if not NODE_HUB_TOKEN:
+        if not ALLOW_OPEN_NODE_REG:
+            raise HTTPException(status_code=503,
+                detail="node registration disabled: set NODE_HUB_TOKEN (or ALLOW_OPEN_NODE_REG=true for dev)")
+    elif _bearer(request) != NODE_HUB_TOKEN:
+        raise HTTPException(status_code=401, detail="bad node hub token")
+    try:
+        body = await request.json()
+    except Exception:
+        raise HTTPException(status_code=400, detail="invalid json")
+
+    url = (body.get("url") or "").strip()
+    if not url:
+        raise HTTPException(status_code=400, detail="url is required")
+
+    now = time.time()
+    nid = _node_id(url)
+    existing = _nodes.get(nid) or {}
+    _nodes[nid] = {
+        "id": nid,
+        "label": body.get("label") or existing.get("label") or nid,
+        "url": url,
+        "api_url": (body.get("api_url") or "").strip() or url,
+        "token": body.get("token") or existing.get("token") or "",
+        "capabilities": body.get("capabilities") or [],
+        "models": body.get("models") or [],
+        "terminal": body.get("terminal"),
+        "version": body.get("version"),
+        "registered_at": existing.get("registered_at") or now,
+        "last_seen": now,
+    }
+    _prune(now)
+    return {"id": nid, "status": "registered"}
+
+
+@router.get("/")
+async def list_nodes(user=Depends(get_verified_user)):
+    now = time.time()
+    _prune(now)
+    nodes = [_view(n, now) for n in _nodes.values()]
+    nodes.sort(key=lambda x: (not x["online"], x["label"].lower()))
+    return nodes
+
+
+@router.delete("/{node_id}")
+async def delete_node(node_id: str, user=Depends(get_verified_user)):
+    if (getattr(user, "role", None) or "") != "admin":
+        raise HTTPException(status_code=403, detail="admin only")
+    existed = _nodes.pop(node_id, None) is not None
+    return {"deleted": existed}
