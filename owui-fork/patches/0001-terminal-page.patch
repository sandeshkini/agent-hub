index 0000000..df40d44
--- /dev/null
+++ b/src/lib/utils/agentTerminals.ts
@@ -0,0 +1,86 @@
+// LOCAL PATCH (agent-hub fork): shared terminal-session store.
+// Terminal sessions live in the left sidebar (like chats) and drive the /terminal page. Kept in a
+// shared store (persisted to localStorage) so the sidebar, the page, and the future inbox stay in
+// sync. Each session = its own persistent shell on host `owui-terminal` via OWUI's /api/v1/terminals
+// proxy. Closing a session also kills the backend shell.
+import { writable, get } from 'svelte/store';
+import { browser } from '$app/environment';
+import { WEBUI_API_BASE_URL } from '$lib/constants';
+
+export type TerminalSession = { id: string; name: string; createdAt: number; pinned?: boolean };
+
+const LS_KEY = 'agent-hub:terminal-sessions';
+const SERVER_ID = 'aibo';
+
+const load = (): { sessions: TerminalSession[]; activeId: string } => {
+	if (!browser) return { sessions: [], activeId: '' };
+	try {
+		const s = JSON.parse(localStorage.getItem(LS_KEY) || '{}');
+		return { sessions: Array.isArray(s.sessions) ? s.sessions : [], activeId: s.activeId || '' };
+	} catch {
+		return { sessions: [], activeId: '' };
+	}
+};
+
+const _init = load();
+export const terminalSessions = writable<TerminalSession[]>(_init.sessions);
+export const activeTerminalId = writable<string>(_init.activeId);
+
+const persist = () => {
+	if (!browser) return;
+	try {
+		localStorage.setItem(
+			LS_KEY,
+			JSON.stringify({ sessions: get(terminalSessions), activeId: get(activeTerminalId) })
+		);
+	} catch {}
+};
+terminalSessions.subscribe(persist);
+activeTerminalId.subscribe(persist);
+
+const uid = () =>
+	'term-' + (globalThis.crypto?.randomUUID?.() ?? `${Date.now()}-${Math.random().toString(36).slice(2)}`);
+
+export const newTerminalSession = (): string => {
+	const list = get(terminalSessions);
+	const s: TerminalSession = { id: uid(), name: `Terminal ${list.length + 1}`, createdAt: Date.now() };
+	terminalSessions.set([...list, s]);
+	activeTerminalId.set(s.id);
+	return s.id;
+};
+
+export const closeTerminalSession = async (id: string) => {
+	if (browser) {
+		try {
+			await fetch(`${WEBUI_API_BASE_URL}/terminals/${SERVER_ID}/api/terminals/${id}`, {
+				method: 'DELETE',
+				headers: { Authorization: `Bearer ${localStorage.getItem('token') ?? ''}` }
+			});
+		} catch {}
+	}
+	const list = get(terminalSessions).filter((x) => x.id !== id);
+	terminalSessions.set(list);
+	if (get(activeTerminalId) === id) activeTerminalId.set(list[list.length - 1]?.id ?? '');
+};
+
+export const renameTerminalSession = (id: string, name: string) => {
+	terminalSessions.set(
+		get(terminalSessions).map((x) => (x.id === id ? { ...x, name: name.trim() || x.name, pinned: true } : x))
+	);
+};
+
+// Auto-title from the terminal's OSC title (cwd/command); skips user-renamed (pinned) sessions.
+export const setSessionTitle = (id: string, title: string) => {
+	const t = (title || '').trim();
+	if (!t) return;
+	terminalSessions.set(
+		get(terminalSessions).map((x) => (x.id === id && !x.pinned ? { ...x, name: t } : x))
+	);
+};
+
+// Ensure there's at least one session and a valid active one (call on the /terminal page).
+export const ensureTerminalSession = () => {
+	if (get(terminalSessions).length === 0) newTerminalSession();
+	const list = get(terminalSessions);
+	if (!list.find((x) => x.id === get(activeTerminalId))) activeTerminalId.set(list[0]?.id ?? '');
+};
diff --git a/src/lib/utils/machineSelector.ts b/src/lib/utils/machineSelector.ts
new file mode 100644
index 0000000..b4813a2
--- /dev/null
+++ b/src/lib/utils/machineSelector.ts
@@ -0,0 +1,82 @@
+// LOCAL PATCH (agent-hub fork, E4): machine (node) selector state.
+// Reads the fork node registry (/api/nodes) — the source of truth for which machines exist, which
+// models each serves, and each machine's terminal server. Selecting a machine scopes BOTH the chat
+// model list (to that machine's model ids) AND the /terminal target (to that machine's terminal id).
+// null selection = "All machines" (no filtering — current behaviour).
+import { writable, derived, get } from 'svelte/store';
+import { browser } from '$app/environment';
+import { WEBUI_API_BASE_URL } from '$lib/constants';
+import { selectedTerminalId } from '$lib/stores';
+
+export type Node = {
+	id: string;
+	label: string;
+	url?: string;
+	api_url?: string;
+	capabilities: string[];
+	models: string[];
+	terminal?: { id: string; name?: string; url?: string; key?: string } | null;
+	version?: string;
+	online: boolean;
+	last_seen?: number;
+};
+
+const SEL_KEY = 'agent-hub:selected-node';
+
+function loadSel(): string | null {
+	if (!browser) return null;
+	try {
+		return localStorage.getItem(SEL_KEY) || null;
+	} catch (e) {
+		return null;
+	}
+}
+
+// Selected node id (persisted). null = All machines.
+export const selectedNodeId = writable<string | null>(loadSel());
+selectedNodeId.subscribe((v) => {
+	if (!browser) return;
+	try {
+		if (v) localStorage.setItem(SEL_KEY, v);
+		else localStorage.removeItem(SEL_KEY);
+	} catch (e) {}
+});
+
+// Self-polling registry: fetches /api/nodes only while something is subscribed.
+export const nodes = writable<Node[]>([], (set) => {
+	if (!browser) return;
+	let alive = true;
+	const tick = async () => {
+		try {
+			const r = await fetch(`${WEBUI_API_BASE_URL}/nodes/`, {
+				headers: { Authorization: `Bearer ${localStorage.getItem('token') ?? ''}` }
+			});
+			if (!r.ok) return;
+			const d = await r.json();
+			if (alive && Array.isArray(d)) set(d);
+		} catch (e) {}
+	};
+	tick();
+	const timer = setInterval(tick, 5000);
+	return () => {
+		alive = false;
+		clearInterval(timer);
+	};
+});
+
+export const selectedNode = derived([nodes, selectedNodeId], ([$nodes, $id]) =>
+	$id ? ($nodes.find((n) => n.id === $id) ?? null) : null
+);
+
+// Set of model ids for the selected machine, or null when "All machines" (no filter).
+export const selectedNodeModelIds = derived(selectedNode, ($n) =>
+	$n && Array.isArray($n.models) && $n.models.length ? new Set($n.models) : null
+);
+
+// Pick a machine: scope models + point the terminal at that machine's terminal server.
+export function selectMachine(id: string | null) {
+	selectedNodeId.set(id);
+	if (!id) return;
+	const n = get(nodes).find((x) => x.id === id);
+	if (n?.terminal?.id) selectedTerminalId.set(n.terminal.id);
+}
