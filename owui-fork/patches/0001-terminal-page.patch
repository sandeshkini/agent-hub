+// LOCAL PATCH (agent-hub fork): shared chat-summary store. Exposes a {chat_id -> summary} map
+// (from /api/inbox — same source as the /inbox page) so the sidebar chat list shows live one-line
+// summaries under titles. Self-managing: it polls ONLY while something subscribes to it (i.e. while
+// chat items are on screen), and stops when nothing does.
+import { writable } from 'svelte/store';
+import { browser } from '$app/environment';
+import { WEBUI_API_BASE_URL } from '$lib/constants';
+
+async function fetchSummaries(): Promise<Record<string, string>> {
+	const r = await fetch(`${WEBUI_API_BASE_URL}/inbox/`, {
+		headers: { Authorization: `Bearer ${localStorage.getItem('token') ?? ''}` }
+	});
+	if (!r.ok) return {};
+	const d = await r.json();
+	const map: Record<string, string> = {};
+	for (const c of d || []) if (c?.id && c?.summary) map[c.id] = c.summary;
+	return map;
+}
+
+export const chatSummaries = writable<Record<string, string>>({}, (set) => {
+	if (!browser) return;
+	let alive = true;
+	const tick = async () => {
+		if (typeof document !== 'undefined' && document.visibilityState !== 'visible') return;
+		try {
+			const m = await fetchSummaries();
+			if (alive) set(m);
+		} catch (e) {}
+	};
+	tick();
+	const timer = setInterval(tick, 5000);
+	return () => {
+		alive = false;
+		clearInterval(timer);
+	};
+});
diff --git a/src/lib/utils/agentTerminals.ts b/src/lib/utils/agentTerminals.ts
