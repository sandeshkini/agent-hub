+<script lang="ts">
+	// LOCAL PATCH (agent-hub fork, E10): a small, subtle machine tag (colored dot + short label) shown on
+	// chat / inbox / terminal rows so you can tell which machine a thing ran on at a glance. Deterministic
+	// hue per label so each machine keeps a stable colour.
+	export let label: string = '';
+	export let online: boolean = true;
+
+	let hue = 210;
+	$: {
+		let h = 0;
+		const s = label || '';
+		for (let i = 0; i < s.length; i++) h = (h * 31 + s.charCodeAt(i)) >>> 0;
+		hue = h % 360;
+	}
+</script>
+
+{#if label}
+	<span
+		class="inline-flex items-center gap-1 shrink-0 text-[10px] leading-none px-1.5 py-0.5 rounded-full bg-gray-100 dark:bg-gray-850 text-gray-500 dark:text-gray-400"
+		title={`Machine: ${label}`}
+	>
+		<span
+			class="size-1.5 rounded-full {online ? '' : 'opacity-40'}"
+			style={`background:hsl(${hue} 60% 55%)`}
+		></span>
+		{label}
+	</span>
+{/if}
