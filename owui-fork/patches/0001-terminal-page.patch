--- /dev/null
+++ b/backend/open_webui/routers/agent_runs.py
@@ -0,0 +1,101 @@
+# LOCAL PATCH (agent-hub fork, Phase 1): agent run / question PRESENCE registry.
+#
+# Purpose: make it visible, hub-wide, what every agent is doing — and stop a blocked run from becoming
+# an invisible dead-end. It is an IN-MEMORY store, per chat_id (like the node registry), holding:
+#   - status: running | needs-input | done | failed   (the "running" dot on sidebar/inbox rows)
+#   - question: a PARKED AskUserQuestion {id, message_id, questions}  — persisted so it survives a browser
+#     reload and is discoverable even when the blocked chat isn't the open one.
+#
+# Writers = the adapters (machine-to-machine, Bearer ADAPTER_KEY): they heartbeat status and park/clear
+# the pending question. Reader = the browser (JWT): polls GET / for dots + "needs input" badges, and
+# hydrates the question card on chat open. A question is cleared when answered (agent_answer) or when the
+# run reports done/failed. Stateless + best-effort: if this is empty, the UI simply shows no presence.
+import hmac
+import os
+import time
+
+from fastapi import APIRouter, Depends, HTTPException, Request
+
+from open_webui.utils.auth import get_verified_user
+
+router = APIRouter()
+
+ADAPTER_KEY = os.environ.get("ADAPTER_KEY", "")
+DONE_TTL = 45        # keep a done/failed run visible briefly (for the toast/anim) then drop
+# Drop a run with no heartbeat this long. Adapters heartbeat every ~25s DURING a turn (empty-patch touch),
+# so a live turn stays fresh and a KILLED turn (adapter restart / dropped SSE) goes stale fast — otherwise
+# it shows a false "running" spinner in the sidebar while the Inbox (real chat state) says done. Keep this
+# comfortably above the adapter heartbeat interval (25s) so a slow turn is never falsely pruned.
+STALE_TTL = int(os.environ.get("AGENT_RUN_STALE_TTL", "90"))
+
+# chat_id -> { status, model, updated_at, question: {id, message_id, questions} | None }
+_runs: dict = {}
+
+
+def _adapter_ok(request: Request) -> bool:
+    # SECURITY (fail-CLOSED): empty ADAPTER_KEY denies; constant-time compare.
+    if not ADAPTER_KEY:
+        return False
+    h = request.headers.get("authorization", "")
+    tok = h[7:].strip() if h.lower().startswith("bearer ") else ""
+    return hmac.compare_digest(tok, ADAPTER_KEY)
+
+
+def _prune(now: float | None = None) -> None:
+    now = now or time.time()
+    drop = []
+    for cid, r in _runs.items():
+        age = now - r.get("updated_at", 0)
+        if age > STALE_TTL:
+            drop.append(cid)
+        elif r.get("status") in ("done", "failed") and age > DONE_TTL:
+            # Drop a finished run after DONE_TTL regardless of a leftover parked question — a done/failed
+            # run must never keep showing a stale "needs input" badge on an already-answered chat.
+            drop.append(cid)
+    for cid in drop:
+        _runs.pop(cid, None)
+
+
+@router.post("/")
+async def set_run(request: Request):
+    """Adapters report a run's status and park/clear its pending question (machine-to-machine)."""
+    if not _adapter_ok(request):
+        raise HTTPException(status_code=401, detail="unauthorized")
+    try:
+        body = await request.json()
+    except Exception:
+        raise HTTPException(status_code=400, detail="invalid json")
+    cid = (body.get("chat_id") or "").strip()
+    if not cid:
+        raise HTTPException(status_code=400, detail="chat_id required")
+    now = time.time()
+    r = _runs.get(cid) or {}
+    if "status" in body:
+        r["status"] = body.get("status")
+        # A finished turn can't still be "waiting for input" — clear any parked question so no stale badge.
+        if body.get("status") in ("done", "failed") and "question" not in body:
+            r["question"] = None
+    if "model" in body:
+        r["model"] = body.get("model")
+    if "question" in body:                 # {id, message_id, questions} to park, or null/None to clear
+        r["question"] = body.get("question")
+    r["updated_at"] = now
+    _runs[cid] = r
+    _prune(now)
+    return {"ok": True}
+
+
+@router.get("/")
+async def list_runs(user=Depends(get_verified_user)):
+    """Browser: current run presence + any parked questions, keyed by chat_id."""
+    now = time.time()
+    _prune(now)
+    return {
+        cid: {
+            "status": r.get("status"),
+            "model": r.get("model"),
+            "question": r.get("question"),
+            "updated_at": int(r.get("updated_at", 0)),
+        }
+        for cid, r in _runs.items()
+    }
diff --git a/backend/open_webui/routers/agent_terminal_sync.py b/backend/open_webui/routers/agent_terminal_sync.py
new file mode 100644
index 0000000..3ad82bf
--- /dev/null
+++ b/backend/open_webui/routers/agent_terminal_sync.py
@@ -0,0 +1,79 @@
+# LOCAL PATCH (agent-hub fork): cross-device terminal-session sync.
+#
+# The terminal-session LIST (which shells are open, their names, the active one, and which machine
+# each is on) is otherwise kept only in the browser's localStorage — so it doesn't follow you across
+# devices. This tiny per-user store persists that list server-side (in the OWUI data volume) so every
+# device logged into the hub sees the same open terminals, exactly like chats. The actual PTYs already
+# live server-side on each machine's owui-terminal keyed by session id, so opening the same id on a
+# second device re-attaches to the same live shell.
+#
+# Model: last-writer-wins by a monotonic `rev` (client-supplied ms timestamp). Small JSON blob per user.
+import json
+import os
+import threading
+
+from fastapi import APIRouter, Depends, Request
+from open_webui.env import DATA_DIR
+from open_webui.utils.auth import get_verified_user
+
+router = APIRouter()
+
+_STORE = os.path.join(str(DATA_DIR), "agent_terminal_sessions.json")
+_lock = threading.Lock()
+
+
+def _read_all() -> dict:
+    try:
+        with open(_STORE, "r", encoding="utf-8") as f:
+            d = json.load(f)
+            return d if isinstance(d, dict) else {}
+    except Exception:
+        return {}
+
+
+def _write_all(d: dict) -> None:
+    tmp = _STORE + ".tmp"
+    with open(tmp, "w", encoding="utf-8") as f:
+        json.dump(d, f)
+    os.replace(tmp, _STORE)  # atomic
+
+
+def _blank() -> dict:
+    return {"sessions": [], "activeId": "", "rev": 0}
+
+
+@router.get("/")
+async def get_sessions(user=Depends(get_verified_user)):
+    """Return this user's persisted terminal-session list ({sessions, activeId, rev})."""
+    with _lock:
+        return _read_all().get(user.id) or _blank()
+
+
+@router.put("/")
+async def put_sessions(request: Request, user=Depends(get_verified_user)):
+    """Upsert this user's terminal-session list. Last-writer-wins by `rev` (client ms timestamp);
+    a stale write (older rev than what's stored) is ignored and the current server state returned."""
+    try:
+        body = await request.json()
+    except Exception:
+        body = {}
+    try:
+        rev = int(body.get("rev") or 0)
+    except (TypeError, ValueError):
+        rev = 0  # tolerate a malformed rev (400-ish input) instead of raising a 500
+    incoming = {
+        "sessions": body.get("sessions") if isinstance(body.get("sessions"), list) else [],
+        "activeId": str(body.get("activeId") or ""),
+        "rev": rev,
+    }
+    with _lock:
+        alld = _read_all()
+        cur = alld.get(user.id) or _blank()
+        if incoming["rev"] < int(cur.get("rev") or 0):
+            return cur  # stale write — keep newer server state
+        alld[user.id] = incoming
+        try:
+            _write_all(alld)
+        except Exception:
+            pass
+        return incoming
