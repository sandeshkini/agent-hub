--- /dev/null
+++ b/src/lib/utils/machineSelector.ts
@@ -0,0 +1,128 @@
+// LOCAL PATCH (agent-hub fork, E4): machine (node) selector state.
+// Reads the fork node registry (/api/nodes) — the source of truth for which machines exist, which
+// models each serves, and each machine's terminal server. Selecting a machine scopes BOTH the chat
+// model list (to that machine's model ids) AND the /terminal target (to that machine's terminal id).
+// null selection = "All machines" (no filtering — current behaviour).
+import { writable, derived, get } from 'svelte/store';
+import { browser } from '$app/environment';
+import { WEBUI_API_BASE_URL } from '$lib/constants';
+import { selectedTerminalId } from '$lib/stores';
+
+export type Node = {
+	id: string;
+	label: string;
+	url?: string;
+	api_url?: string;
+	capabilities: string[];
+	models: string[];
+	terminal?: { id: string; name?: string; url?: string; key?: string } | null;
+	version?: string;
+	online: boolean;
+	last_seen?: number;
+};
+
+const SEL_KEY = 'agent-hub:selected-node';
+
+function loadSel(): string | null {
+	if (!browser) return null;
+	try {
+		return localStorage.getItem(SEL_KEY) || null;
+	} catch (e) {
+		return null;
+	}
+}
+
+// Selected node id (persisted). null = All machines.
+export const selectedNodeId = writable<string | null>(loadSel());
+selectedNodeId.subscribe((v) => {
+	if (!browser) return;
+	try {
+		if (v) localStorage.setItem(SEL_KEY, v);
+		else localStorage.removeItem(SEL_KEY);
+	} catch (e) {}
+});
+
+// Self-polling registry: fetches /api/nodes only while something is subscribed.
+export const nodes = writable<Node[]>([], (set) => {
+	if (!browser) return;
+	let alive = true;
+	const tick = async () => {
+		try {
+			const r = await fetch(`${WEBUI_API_BASE_URL}/nodes/`, {
+				headers: { Authorization: `Bearer ${localStorage.getItem('token') ?? ''}` }
+			});
+			if (!r.ok) return;
+			const d = await r.json();
+			if (alive && Array.isArray(d)) set(d);
+		} catch (e) {}
+	};
+	tick();
+	const timer = setInterval(tick, 5000);
+	return () => {
+		alive = false;
+		clearInterval(timer);
+	};
+});
+
+export const selectedNode = derived([nodes, selectedNodeId], ([$nodes, $id]) =>
+	$id ? ($nodes.find((n) => n.id === $id) ?? null) : null
+);
+
+// Set of model ids for the selected machine, or null when "All machines" (no filter).
+export const selectedNodeModelIds = derived(selectedNode, ($n) =>
+	$n && Array.isArray($n.models) && $n.models.length ? new Set($n.models) : null
+);
+
+// ── E10: machine attribution (which machine a chat/terminal belongs to) ──
+// A model id without a "<machine>." prefix (e.g. `claude-sonnet-5`, `opencode/glm-5.2`, `hermes`) is a
+// LOCAL/hub model; a prefixed id (e.g. `mb.claude-sonnet-5`) belongs to a remote node.
+const isLocalModelId = (m: string): boolean => !/^[a-z0-9-]+\.[a-z]/i.test(m || '');
+
+// The hub node = the one serving local (unprefixed) models; fallback to first online node.
+export const hubNode = derived(nodes, ($nodes) =>
+	$nodes.find((n) => (n.models || []).some(isLocalModelId)) ??
+	$nodes.find((n) => n.online) ??
+	$nodes[0] ??
+	null
+);
+
+// The node that serves a given model id. OWUI stores remote-connection models as `<prefix>.<id>`
+// (e.g. `mb.claude-sonnet-5`), but a node's advertised list may carry either the prefixed id or the
+// bare id. Match exactly first, then fall back to comparing on the bare suffix so attribution still
+// resolves if the two forms disagree (otherwise every remote chat mis-attributes to the hub node).
+const bareModel = (m: string): string => (m || '').replace(/^[a-z0-9-]+\./i, '');
+export function machineForModel(modelId: string | null | undefined, nodesList: Node[]): Node | null {
+	if (!modelId) return null;
+	const exact = nodesList.find((n) => Array.isArray(n.models) && n.models.includes(modelId));
+	if (exact) return exact;
+	const target = bareModel(modelId);
+	return (
+		nodesList.find(
+			(n) => Array.isArray(n.models) && n.models.some((m) => m === target || bareModel(m) === target)
+		) ?? null
+	);
+}
+
+// The node that owns a given terminal-server id (each node advertises terminal.id).
+export function machineForTerminal(serverId: string | null | undefined, nodesList: Node[]): Node | null {
+	if (!serverId) return null;
+	return nodesList.find((n) => n.terminal && n.terminal.id === serverId) ?? null;
+}
+
+// The machine id a chat belongs to, given its primary model. Unknown/local models → the hub node.
+export function machineIdForModel(
+	modelId: string | null | undefined,
+	nodesList: Node[],
+	hub: Node | null
+): string | null {
+	const n = machineForModel(modelId, nodesList);
+	return n ? n.id : hub?.id ?? null;
+}
+
+// Pick a machine: scope models + point the terminal at that machine's terminal server.
+export function selectMachine(id: string | null) {
+	selectedNodeId.set(id);
+	if (!id) return;
+	const n = get(nodes).find((x) => x.id === id);
+	if (n?.terminal?.id) selectedTerminalId.set(n.terminal.id);
+}
