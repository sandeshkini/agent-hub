+<script lang="ts">
+	// LOCAL PATCH (agent-hub fork): dedicated Terminal page. Sessions are managed in the LEFT SIDEBAR
+	// (shared store $lib/utils/agentTerminals — inbox-ready); this page renders the active shell
+	// full-width with a slim action bar (rename active + font size + reconnect + Files panel toggle).
+	// Auto-titles sessions from the terminal's OSC title (cwd/command). No chat/model.
+	// The Files panel reuses OWUI's native FileNav against the aibo terminal server's file-API
+	// (/files/*), scoped to the active session's cwd via chatId.
+	import { onMount, onDestroy, getContext } from 'svelte';
+	import { get } from 'svelte/store';
+	import { terminalServers, selectedTerminalId, showSidebar, mobile } from '$lib/stores';
+	import {
+		terminalSessions,
+		activeTerminalId,
+		newTerminalSession,
+		renameTerminalSession,
+		setSessionTitle,
+		ensureTerminalSession
+	} from '$lib/utils/agentTerminals';
+	import { getTerminalServers } from '$lib/apis/terminal';
+	import XTerminal from '$lib/components/chat/XTerminal.svelte';
+	import FileNav from '$lib/components/chat/FileNav.svelte';
+	import Spinner from '$lib/components/common/Spinner.svelte';
+	import MenuLines from '$lib/components/icons/MenuLines.svelte';
+	import Folder from '$lib/components/icons/Folder.svelte';
+	import XMark from '$lib/components/icons/XMark.svelte';
+
+	const i18n = getContext('i18n');
+	const SERVER_ID = 'aibo';
+	const FS_KEY = 'agent-hub:terminal-fontsize';
+	const FILES_KEY = 'agent-hub:terminal-files-open';
+
+	let loaded = false;
+	let hasServer = false;
+	let reconnectKey = 0;
+	let renaming = false;
+	let renameValue = '';
+	let fontSize = 13;
+	let showFiles = false;
+
+	$: active = $terminalSessions.find((s) => s.id === $activeTerminalId) ?? null;
+
+	const setFont = (n: number) => {
+		fontSize = Math.min(22, Math.max(9, n));
+		try { localStorage.setItem(FS_KEY, String(fontSize)); } catch (e) {}
+	};
+	const toggleFiles = () => {
+		showFiles = !showFiles;
+		try { localStorage.setItem(FILES_KEY, showFiles ? '1' : '0'); } catch (e) {}
+	};
+	const startRename = () => { if (active) { renameValue = active.name; renaming = true; } };
+	const commitRename = () => { if (active) renameTerminalSession(active.id, renameValue); renaming = false; };
+	const onTitle = (t: string) => {
+		if (!$activeTerminalId) return;
+		const short = (t || '').includes(': ') ? t.split(': ').slice(1).join(': ') : t;
+		setSessionTitle($activeTerminalId, short);
+	};
+
+	// LOCAL PATCH (mobile key bar): a soft-key row for keys mobile keyboards lack (Esc, Ctrl-C, arrows…).
+	// Trimmed to what fits one row (flex-filled, no horizontal scroll); symbols like | ~ / are on the
+	// iOS keyboard's .?123 layer already.
+	let xterm: any;
+	let termConnected = false;
+	let termConnecting = false;
+	const KEYS = [
+		{ label: '⌨', act: 'focus' },
+		{ label: 'Esc', seq: '\x1b' },
+		{ label: 'Tab', seq: '\t' },
+		{ label: '^C', seq: '\x03' },
+		{ label: '^D', seq: '\x04' },
+		{ label: '^Z', seq: '\x1a' },
+		{ label: '^A', seq: '\x01' },
+		{ label: '|', seq: '|' },
+		{ label: '/', seq: '/' },
+		{ label: '←', seq: '\x1b[D' },
+		{ label: '↑', seq: '\x1b[A' },
+		{ label: '↓', seq: '\x1b[B' },
+		{ label: '→', seq: '\x1b[C' }
+	];
+	// One handler via pointerdown (fires ONCE for touch+mouse): the old touchstart+mousedown pair
+	// double-sent every key on iOS. preventDefault keeps the keyboard up; sendKey/focus refocuses.
+	const pressKey = (k: any) => {
+		if (k.act === 'focus') xterm?.focus?.();
+		else if (k.seq) xterm?.sendKey?.(k.seq);
+	};
+
+	// iOS: the on-screen keyboard overlays the layout viewport, so a bottom bar hides behind it.
+	// Track the visual viewport and lift the bar by the keyboard height so it sits just above it.
+	let kbOffset = 0;
+	let vvHeight = 0;
+	const onViewport = () => {
+		const vv = (window as any).visualViewport;
+		if (!vv) return;
+		vvHeight = Math.round(vv.height);
+		kbOffset = Math.max(0, Math.round(window.innerHeight - vv.height - vv.offsetTop));
+		// Keyboard show/hide changed the usable height → refit the terminal and keep the prompt visible,
+		// so rows don't end up hidden behind the keyboard.
+		requestAnimationFrame(() => xterm?.fit?.());
+	};
+
+	onMount(async () => {
+		try { fontSize = Number(localStorage.getItem(FS_KEY)) || 13; } catch (e) {}
+		try { showFiles = localStorage.getItem(FILES_KEY) === '1'; } catch (e) {}
+		const servers = await getTerminalServers(localStorage.token).catch(() => []);
+		terminalServers.set(servers ?? []);
+		// LOCAL PATCH (E4): honour the machine selector's choice if it points at a real server,
+		// else fall back to the default aibo/first server.
+		const cur = get(selectedTerminalId);
+		const t =
+			(servers ?? []).find((s: any) => s.id === cur) ??
+			(servers ?? []).find((s: any) => s.id === SERVER_ID) ??
+			(servers ?? [])[0];
+		if (t?.id) { selectedTerminalId.set(t.id); hasServer = true; }
+		await ensureTerminalSession();
+		loaded = true;
+		const vv = (window as any).visualViewport;
+		if (vv) { vv.addEventListener('resize', onViewport); vv.addEventListener('scroll', onViewport); onViewport(); }
+	});
+
+	onDestroy(() => {
+		const vv = (window as any).visualViewport;
+		if (vv) { vv.removeEventListener('resize', onViewport); vv.removeEventListener('scroll', onViewport); }
+	});
+</script>
+
+<svelte:head><title>{$i18n.t('Terminal')}</title></svelte:head>
