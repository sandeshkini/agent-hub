new file mode 100644
index 0000000..a6f3cca
--- /dev/null
+++ b/backend/open_webui/routers/agent_inbox.py
@@ -0,0 +1,117 @@
+# LOCAL PATCH (agent-hub fork): E2 Inbox with real-time smart summaries.
+# Returns the user's chat list (same snippet/active/unread data as OWUI's list) with a one-line
+# LLM summary attached per chat. Summaries are cached and regenerated ONLY when a chat changes
+# (updated_at), in the background (bounded concurrency), via the local Ollama model — so the /inbox
+# page can poll this cheaply and watch summaries update live. Additive: new router, own prefix.
+import asyncio
+import os
+
+import aiohttp
+from fastapi import APIRouter, Depends, Request
+from sqlalchemy.ext.asyncio import AsyncSession
+
+from open_webui.internal.db import get_async_session
+from open_webui.models.chats import Chats
+from open_webui.routers.chats import add_active_state_to_chat_list
+from open_webui.utils.auth import get_verified_user
+
+router = APIRouter()
+
+OLLAMA_BASE_URL = os.environ.get("OLLAMA_BASE_URL", "http://ollama:11434").rstrip("/")
+SUMMARY_MODEL = os.environ.get("INBOX_SUMMARY_MODEL", "llama3.2:3b")
+
+_summaries: dict = {}          # chat_id -> {"updated_at": int, "summary": str}
+_inflight: set = set()
+_sema = asyncio.Semaphore(2)   # cap concurrent CPU summarizations
+
+
+def _messages_text(chat_obj) -> str:
+    try:
+        data = getattr(chat_obj, "chat", None) or {}
+        hist = ((data or {}).get("history") or {}).get("messages") or {}
+        msgs = [m for m in hist.values() if isinstance(m, dict)]
+        msgs.sort(key=lambda m: m.get("timestamp") or 0)
+        lines = []
+        for m in msgs[-8:]:
+            c = (m.get("content") or "").strip()
+            if c:
+                lines.append(f"{m.get('role', '?')}: {c[:400]}")
+        return "\n".join(lines)
+    except Exception:
+        return ""
+
+
+async def _generate_summary(text: str):
+    prompt = (
+        "In 4 to 8 words, write a concise title describing what this conversation is about. "
+        "Output ONLY the title — no quotes, no trailing period.\n\nConversation:\n"
+        + text[:4000]
+        + "\n\nTitle:"
+    )
+    try:
+        async with aiohttp.ClientSession() as s:
+            async with s.post(
+                f"{OLLAMA_BASE_URL}/api/generate",
+                json={
+                    "model": SUMMARY_MODEL,
+                    "prompt": prompt,
+                    "stream": False,
+                    "options": {"num_predict": 24, "temperature": 0.2},
+                },
+                timeout=aiohttp.ClientTimeout(total=45),
+            ) as r:
+                d = await r.json()
+                out = (d.get("response") or "").strip().strip('"').strip()
+                out = out.split("\n")[0].strip()[:90]
+                return out or None
+    except Exception:
+        return None
+
+
+async def _regen(chat_id: str, updated_at: int):
+    try:
+        async with _sema:
+            chat = await Chats.get_chat_by_id(chat_id)  # manages its own session
+            if chat is None:
+                return
+            text = _messages_text(chat)
+            if not text:
+                return
+            summary = await _generate_summary(text)
+            if summary:
+                _summaries[chat_id] = {"updated_at": updated_at, "summary": summary}
+    finally:
+        _inflight.discard(chat_id)
+
+
+@router.get("/")
+async def get_inbox(
+    request: Request,
+    user=Depends(get_verified_user),
+    db: AsyncSession = Depends(get_async_session),
+):
+    chats = await Chats.get_chat_title_id_list_by_user_id(
+        user.id,
+        include_folders=True,
+        include_pinned=True,
+        sort_by="updated_at",
+        sort_dir="desc",
+        skip=0,
+        limit=40,
+        db=db,
+    )
+    chats = await add_active_state_to_chat_list(request, chats)
+
+    out = []
+    for c in chats:
+        item = c.model_dump() if hasattr(c, "model_dump") else dict(c)
+        cid = item.get("id")
+        ua = item.get("updated_at")
+        cached = _summaries.get(cid)
+        # (re)generate in the background when missing or the chat changed since the cached summary
+        if (cached is None or cached.get("updated_at") != ua) and cid not in _inflight:
+            _inflight.add(cid)
+            asyncio.create_task(_regen(cid, ua))
+        item["summary"] = (cached or {}).get("summary")
+        out.append(item)
+    return out
