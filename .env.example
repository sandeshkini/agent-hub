# ─────────────────────────────────────────────────────────────────────────────
# Agent Hub — copy to .env and fill in (.env is gitignored + chmod 600). `./setup.sh` reads this.
# ROLE: set COMPOSE_PROFILES=hub (the OWUI box) or =node (a worker machine).
# ─────────────────────────────────────────────────────────────────────────────

# hub = full Open WebUI + adapters + ollama + mcp + registrar
# node = adapters + registrar only (registers into a remote hub)
# add `slack` to also run the Slack gateway once tokens are set, e.g. COMPOSE_PROFILES=hub,slack
# host port Open WebUI binds on (container is always 8080)
OWUI_PORT=3000
COMPOSE_PROFILES=hub

# ── Slack gateway (optional; profile `slack`) ──
# xoxb-… (Bot User OAuth Token)
SLACK_BOT_TOKEN=
# xapp-… (App-Level Token, scope connections:write, Socket Mode)
SLACK_APP_TOKEN=
# OWUI API key / token the gateway uses to drive /api/chat/completions
OWUI_API_KEY=
SLACK_DEFAULT_MODEL=claude-sonnet-5

# ── shared ──
# bearer OWUI↔adapters use
ADAPTER_KEY=change-me-shared-adapter-bearer
# `claude setup-token` (subscription; NOT ANTHROPIC_API_KEY)
CLAUDE_CODE_OAUTH_TOKEN=
# opencode Zen provider key
OPENCODE_API_KEY=
CLAUDE_MODELS=claude-opus-5,claude-sonnet-5,claude-fable-5,claude-opus-4-8,claude-haiku-4-5
CLAUDE_MODEL=claude-sonnet-5
# BARE model names — the adapter prepends the `opencode/` prefix itself. Writing them already
# prefixed here yields double-prefixed ids (`opencode/opencode/glm-5.2`) that OWUI can't route.
OPENCODE_MODELS=glm-5.2,kimi-k3,deepseek-v4-pro
# where the adapter host-ports bind: 127.0.0.1 on a hub (OWUI uses service names), 0.0.0.0 on a node
# so the remote hub can reach them over the LAN.
ADAPTER_BIND=127.0.0.1
# External MCP hub: add servers ONCE here -> every adapter gets them. JSON list of {name,url[,type]}.
# e.g. MCP_SERVERS=[{"name":"linear","url":"https://mcp.linear.app/mcp"},{"name":"custom","url":"http://host:9000/mcp"}]
MCP_SERVERS=[]
# ⚠️ EDIT FOR YOUR MACHINE (defaults are aibo/Linux). macOS: WORKSPACE_HOST=/Users/you, WORKSPACE=/Users/you, DOCKER_USER= (blank)
WORKSPACE_HOST=/home/you        # your home dir (run: echo $HOME). macOS: /Users/you
WORKSPACE=/home/you             # same path; the host home is mounted read/write into adapters
DOCKER_USER=1000:1000                     # your uid:gid (id -u / id -g); blank on macOS

# ── hub-only (Open WebUI) ──
# PINNED → stable sessions (openssl rand -hex 32)
WEBUI_SECRET_KEY=change-me-64-hex
# gate /api/v1/nodes/register (empty = open, trusted LAN)
NODE_HUB_TOKEN=
# this box's owui-terminal token (from owui-terminal/install.sh)
TERMINAL_TOKEN=
HERMES_DASH_USER=
HERMES_DASH_PW=                                       # PLAINTEXT — owui-hermes basic-auths to the brain with it
# Hermes brain(s) — host service via ./hermes/install.sh (needs base NousResearch/hermes-agent,
# public: curl -fsSL https://hermes-agent.nousresearch.com/install.sh | bash).
# Hermes model provider (glm-5.2, vision)
OPENROUTER_API_KEY=
# scrypt hash of HERMES_DASH_PW. The dashboard binds 0.0.0.0 — leave BOTH blank and it is an
# unauthenticated agent shell on your LAN. Generate:
#   cd ~/.hermes/hermes-agent && venv/bin/python -c \
#     "import sys;sys.path.insert(0,'.');from plugins.dashboard_auth.basic import hash_password;print(hash_password('YOURPW'))"
# ⚠️ ESCAPE every `$` as `$$` when pasting it here — docker compose interpolates `$` in .env and
# would otherwise blank the value (hermes/install.sh un-escapes on read).
HERMES_DASH_PW_HASH=                                  # e.g. scrypt$$16384$$8$$1$$<salt>$$<dk>
HERMES_INSTANCES=default:9119                         # comma-list name:port for multiple brains (E8.2), e.g. default:9119,coder:9120
TAVILY_API_KEY=
PUBLISH_TOKEN=
# Base URL used to build shareable artifact page links (publish_artifact tool). Set to your
# public domain if you expose the artifacts board (e.g. https://apps.example.com); default is local.
PUBLIC_BASE=http://localhost:8080
NTFY_URL=
NTFY_TOPIC=
NTFY_TOKEN=
# OWUI_IMAGE=agent-hub/open-webui:v0.11.0-fork       # (fork is default; override to pin/rollback)

# ── registrar (this machine's entry in the machine selector) ──
# HUB:  defaults are fine (registers this box against the in-container OWUI).
# NODE: point HUB_REGISTER_URL at the hub's LAN address and describe THIS machine.
HUB_REGISTER_URL=http://open-webui:8080/api/v1/nodes/register    # NODE: http://<hub-lan-ip>:3000/api/v1/nodes/register
NODE_LABEL=aibo
NODE_URL=http://<hub-lan-ip>:3000
NODE_API_URL=http://<this-machine-lan-ip>:3000                # NODE: this box's LAN URL
NODE_TOKEN=
NODE_CAPABILITIES=terminal,claude,opencode,hermes
# comma-separated OWUI model ids this machine serves (NODE: use your prefixed ids, e.g. mb.claude-sonnet-5)
NODE_MODELS=hermes,claude-opus-5,claude-sonnet-5,opencode/glm-5.2
TERMINAL_ID=aibo                                              # must match an OWUI terminal-server id
TERMINAL_NAME=aibo (host shell)
TERMINAL_URL=                                                 # NODE: http://<this-machine-lan-ip>:7681
# NODE: this machine's TERMINAL_TOKEN
TERMINAL_KEY=
HEARTBEAT_SECONDS=30
