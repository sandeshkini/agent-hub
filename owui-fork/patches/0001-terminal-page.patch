+<script lang="ts">
+	// LOCAL PATCH (agent-hub fork): dedicated Terminal page. Sessions are managed in the LEFT SIDEBAR
+	// (shared store $lib/utils/agentTerminals — inbox-ready); this page renders the active shell
+	// full-width with a slim action bar (rename active + font size + reconnect + Files panel toggle).
+	// Auto-titles sessions from the terminal's OSC title (cwd/command). No chat/model.
+	// The Files panel reuses OWUI's native FileNav against the aibo terminal server's file-API
+	// (/files/*), scoped to the active session's cwd via chatId.
+	import { onMount, getContext } from 'svelte';
+	import { get } from 'svelte/store';
+	import { terminalServers, selectedTerminalId, showSidebar, mobile } from '$lib/stores';
+	import {
+		terminalSessions,
+		activeTerminalId,
+		newTerminalSession,
+		renameTerminalSession,
+		setSessionTitle,
+		ensureTerminalSession
+	} from '$lib/utils/agentTerminals';
+	import { getTerminalServers } from '$lib/apis/terminal';
+	import XTerminal from '$lib/components/chat/XTerminal.svelte';
+	import FileNav from '$lib/components/chat/FileNav.svelte';
+	import Spinner from '$lib/components/common/Spinner.svelte';
+	import MenuLines from '$lib/components/icons/MenuLines.svelte';
+	import Folder from '$lib/components/icons/Folder.svelte';
+	import XMark from '$lib/components/icons/XMark.svelte';
+
+	const i18n = getContext('i18n');
+	const SERVER_ID = 'aibo';
+	const FS_KEY = 'agent-hub:terminal-fontsize';
+	const FILES_KEY = 'agent-hub:terminal-files-open';
+
+	let loaded = false;
+	let hasServer = false;
+	let reconnectKey = 0;
+	let renaming = false;
+	let renameValue = '';
+	let fontSize = 13;
+	let showFiles = false;
+
+	$: active = $terminalSessions.find((s) => s.id === $activeTerminalId) ?? null;
+
+	const setFont = (n: number) => {
+		fontSize = Math.min(22, Math.max(9, n));
+		try { localStorage.setItem(FS_KEY, String(fontSize)); } catch (e) {}
+	};
+	const toggleFiles = () => {
+		showFiles = !showFiles;
+		try { localStorage.setItem(FILES_KEY, showFiles ? '1' : '0'); } catch (e) {}
+	};
+	const startRename = () => { if (active) { renameValue = active.name; renaming = true; } };
+	const commitRename = () => { if (active) renameTerminalSession(active.id, renameValue); renaming = false; };
+	const onTitle = (t: string) => {
+		if (!$activeTerminalId) return;
+		const short = (t || '').includes(': ') ? t.split(': ').slice(1).join(': ') : t;
+		setSessionTitle($activeTerminalId, short);
+	};
+
+	onMount(async () => {
+		try { fontSize = Number(localStorage.getItem(FS_KEY)) || 13; } catch (e) {}
+		try { showFiles = localStorage.getItem(FILES_KEY) === '1'; } catch (e) {}
+		const servers = await getTerminalServers(localStorage.token).catch(() => []);
+		terminalServers.set(servers ?? []);
+		// LOCAL PATCH (E4): honour the machine selector's choice if it points at a real server,
+		// else fall back to the default aibo/first server.
+		const cur = get(selectedTerminalId);
+		const t =
+			(servers ?? []).find((s: any) => s.id === cur) ??
+			(servers ?? []).find((s: any) => s.id === SERVER_ID) ??
+			(servers ?? [])[0];
+		if (t?.id) { selectedTerminalId.set(t.id); hasServer = true; }
+		ensureTerminalSession();
+		loaded = true;
+	});
+</script>
+
+<svelte:head><title>{$i18n.t('Terminal')}</title></svelte:head>
+
+<div class="h-full w-full flex flex-col overflow-hidden">
+	<div class="flex items-center gap-1.5 px-2 py-1.5 border-b border-gray-50 dark:border-gray-850 shrink-0">
+		{#if $mobile && !$showSidebar}
+			<button class="p-1.5 shrink-0 rounded-lg hover:bg-gray-50 dark:hover:bg-gray-900"
+				aria-label="Menu" on:click={() => showSidebar.set(true)}>
+				<MenuLines className="size-5" />
+			</button>
+		{/if}
+		{#if renaming}
+			<!-- svelte-ignore a11y-autofocus -->
+			<input class="text-sm font-medium bg-transparent outline-hidden min-w-0 flex-1" bind:value={renameValue}
+				autofocus on:blur={commitRename} on:keydown={(e) => e.key === 'Enter' && commitRename()} />
+		{:else}
+			<div class="text-sm font-medium truncate flex-1 min-w-0 cursor-text" title={$i18n.t('Rename')}
+				on:dblclick={startRename}>{active?.name ?? $i18n.t('Terminal')}</div>
+		{/if}
+
+		<div class="shrink-0 flex items-center text-gray-500">
+			<button class="px-1.5 py-1 rounded-lg hover:bg-gray-50 dark:hover:bg-gray-900 transition text-xs"
+				title={$i18n.t('Smaller')} on:click={() => setFont(fontSize - 1)}>A−</button>
+			<button class="px-1.5 py-1 rounded-lg hover:bg-gray-50 dark:hover:bg-gray-900 transition text-sm"
+				title={$i18n.t('Larger')} on:click={() => setFont(fontSize + 1)}>A+</button>
+			<button class="px-2 py-1 rounded-lg hover:bg-gray-50 dark:hover:bg-gray-900 transition text-xs"
+				title={$i18n.t('Reconnect')} on:click={() => (reconnectKey += 1)}>⟳</button>
+			<button
+				class="p-1 ml-0.5 rounded-lg hover:bg-gray-50 dark:hover:bg-gray-900 transition {showFiles ? 'text-gray-900 dark:text-white bg-gray-100 dark:bg-gray-850' : ''}"
+				title={$i18n.t('Files')} aria-pressed={showFiles} on:click={toggleFiles}>
+				<Folder className="size-4" />
+			</button>
+		</div>
+	</div>
+
+	<div class="flex-1 min-h-0 flex relative">
+		<div class="flex-1 min-w-0 min-h-0 bg-black">
+			{#if !loaded}
+				<div class="h-full flex items-center justify-center"><Spinner /></div>
+			{:else if !hasServer}
+				<div class="h-full flex items-center justify-center text-gray-400 text-sm text-center px-6">
+					{$i18n.t('No terminal server configured. Add one in Admin Settings → Integrations.')}
+				</div>
+			{:else if $activeTerminalId}
+				{#key $activeTerminalId + '-' + reconnectKey}
+					<div class="h-full w-full p-1.5"><XTerminal chatId={$activeTerminalId} {fontSize} on:title={(e) => onTitle(e.detail)} /></div>
+				{/key}
+			{:else}
+				<div class="h-full flex items-center justify-center">
+					<button class="px-3 py-1.5 text-sm rounded-lg border border-gray-200 dark:border-gray-800 hover:bg-gray-900/40 text-gray-300"
+						on:click={newTerminalSession}>+ {$i18n.t('New Terminal')}</button>
+				</div>
+			{/if}
+		</div>
+
+		{#if showFiles && hasServer}
+			<!-- Files panel: side-drawer on desktop, full overlay on mobile. Reuses native FileNav. -->
+			<div
+				class="{$mobile ? 'absolute inset-0 z-20' : 'relative w-80 lg:w-96 shrink-0 border-l border-gray-50 dark:border-gray-850'} flex flex-col min-h-0 bg-white dark:bg-gray-900"
+			>
+				<div class="flex items-center justify-between px-2 py-1.5 border-b border-gray-50 dark:border-gray-850 shrink-0">
+					<div class="text-sm font-medium text-gray-700 dark:text-gray-200">{$i18n.t('Files')}</div>
+					<button class="p-1 rounded-lg hover:bg-gray-50 dark:hover:bg-gray-900 text-gray-500"
+						aria-label={$i18n.t('Close')} on:click={toggleFiles}>
+						<XMark className="size-4" />
+					</button>
+				</div>
+				<div class="flex-1 min-h-0 overflow-hidden">
+					<FileNav chatId={$activeTerminalId} />
+				</div>
+			</div>
+		{/if}
+	</div>
+</div>
