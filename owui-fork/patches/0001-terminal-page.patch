+	// LOCAL PATCH (agent-hub fork, #70): keep an actively-streaming assistant message visible across
+	// navigation. The DB snapshot lags the server-side mirror throttle (~1.5s), so returning to a chat
+	// mid-stream could briefly show a shorter/blank message ("everything I saw is gone, only see what's
+	// next"). We stash the fullest streamed content per chat in sessionStorage and restore it on loadChat
+	// when it's longer than the DB copy — never shrinks, never touches a finished message. For our
+	// replace-based adapters this is exact; the next mirror event re-syncs regardless.
+	const streamStashKey = (cid) => `owui:stream:${cid}`;
+	const stashStreamingContent = (cid, msg) => {
+		if (typeof sessionStorage === 'undefined' || !cid || !msg || msg.role !== 'assistant') return;
+		try {
+			const key = streamStashKey(cid);
+			if (!msg.done && (msg.content ?? '') !== '') {
+				sessionStorage.setItem(key, JSON.stringify({ id: msg.id, content: msg.content }));
+			} else if (msg.done) {
+				sessionStorage.removeItem(key);
+			}
+		} catch (e) {}
+	};
+	const restoreStreamingContent = (cid) => {
+		if (typeof sessionStorage === 'undefined' || !cid) return;
+		try {
+			const raw = sessionStorage.getItem(streamStashKey(cid));
+			if (!raw) return;
+			const stash = JSON.parse(raw);
+			const m = stash?.id ? history?.messages?.[stash.id] : null;
+			if (
+				m &&
+				m.role === 'assistant' &&
+				!m.done &&
+				typeof stash.content === 'string' &&
+				stash.content.length > (m.content ?? '').length
+			) {
+				m.content = stash.content;
+			}
+		} catch (e) {}
+	};
