@@ -0,0 +1,21 @@
+// LOCAL PATCH (agent-hub fork, E7): pending AskUserQuestion prompts, keyed by chat id.
+// The Claude adapter emits an `agent:question` socket event; Chat.svelte pushes it here; an
+// AgentQuestion card renders the options and POSTs the answer back to /api/agent/answer.
+import { writable } from 'svelte/store';
+
+export type AgentQuestion = { id: string; questions: any[] };
+
+export const agentQuestions = writable<Record<string, AgentQuestion[]>>({});
+
+export function addQuestion(chatId: string, q: AgentQuestion) {
+	if (!chatId || !q?.id) return;
+	agentQuestions.update((m) => {
+		const list = m[chatId] ?? [];
+		if (list.some((x) => x.id === q.id)) return m; // dedupe
+		return { ...m, [chatId]: [...list, q] };
+	});
+}
+
+export function removeQuestion(chatId: string, id: string) {
+	agentQuestions.update((m) => ({ ...m, [chatId]: (m[chatId] ?? []).filter((x) => x.id !== id) }));
+}
diff --git a/src/lib/utils/agentRuns.ts b/src/lib/utils/agentRuns.ts
new file mode 100644
index 0000000..1fb4952
--- /dev/null
+++ b/src/lib/utils/agentRuns.ts
@@ -0,0 +1,48 @@
+// LOCAL PATCH (agent-hub fork, Phase 1): agent run/question PRESENCE.
+// Polls the fork registry (/api/v1/agent-runs) so the sidebar/inbox can show a "running" dot and a
+// "needs input" badge per chat, and — critically — HYDRATES a parked AskUserQuestion into agentQuestions
+// so it survives a page reload and shows up when the user opens the (previously non-active) chat.
+// Also reconciles: when the adapter reports a chat is no longer waiting, clears any stale card.
+import { writable } from 'svelte/store';
+import { browser } from '$app/environment';
+import { WEBUI_API_BASE_URL } from '$lib/constants';
+import { addQuestion, agentQuestions } from './agentQuestions';
+
+export type AgentRun = {
+	status?: 'running' | 'needs-input' | 'done' | 'failed' | string;
+	model?: string;
+	question?: { id: string; message_id?: string; questions: any[] } | null;
+	updated_at?: number;
+};
+
+export const agentRuns = writable<Record<string, AgentRun>>({}, (set) => {
+	if (!browser) return;
+	let alive = true;
+	const tick = async () => {
+		if (typeof document !== 'undefined' && document.visibilityState !== 'visible') return;
+		try {
+			const r = await fetch(`${WEBUI_API_BASE_URL}/agent-runs/`, {
+				headers: { Authorization: `Bearer ${localStorage.getItem('token') ?? ''}` }
+			});
+			if (!r.ok) return;
+			const runs: Record<string, AgentRun> = await r.json();
+			if (!alive) return;
+			set(runs);
+			// Hydrate parked questions + clear stale ones the registry no longer parks.
+			for (const [cid, run] of Object.entries(runs)) {
+				if (run?.question?.id) {
+					addQuestion(cid, { id: run.question.id, questions: run.question.questions });
+				} else if (run?.status && run.status !== 'needs-input') {
+					// adapter says this chat is no longer waiting (answered / turn ended) → drop any card
+					agentQuestions.update((m) => (m[cid]?.length ? { ...m, [cid]: [] } : m));
+				}
+			}
+		} catch (e) {}
+	};
+	tick();
+	const timer = setInterval(tick, 4000);
+	return () => {
+		alive = false;
+		clearInterval(timer);
+	};
+});
diff --git a/src/lib/utils/agentTerminals.ts b/src/lib/utils/agentTerminals.ts
new file mode 100644
index 0000000..3e1e89d
--- /dev/null
+++ b/src/lib/utils/agentTerminals.ts
@@ -0,0 +1,247 @@
+// LOCAL PATCH (agent-hub fork): shared terminal-session store — now CROSS-DEVICE SYNCED.
+// Terminal sessions live in the left sidebar (like chats) and drive the /terminal page. The list is
+// cached in localStorage for instant paint AND persisted server-side (fork `/api/v1/terminal-sessions`)
+// so every device logged into the hub sees the same open terminals. The actual PTYs live server-side on
+// each machine's owui-terminal keyed by session id, so opening the same id on a 2nd device re-attaches
+// to the same live shell. Sync is last-writer-wins by a monotonic `rev` (ms timestamp); we push on
+// local change (debounced) and pull on focus + a light poll.
+import { writable, get } from 'svelte/store';
+import { browser } from '$app/environment';
+import { WEBUI_API_BASE_URL } from '$lib/constants';
+import { selectedTerminalId, terminalServers } from '$lib/stores'; // LOCAL PATCH (E10): stamp each shell's machine
+
+export type TerminalSession = {
+	id: string;
+	name: string;
+	createdAt: number;
+	pinned?: boolean;
+	serverId?: string; // which machine this shell runs on (multi-machine); optional
+	discovered?: boolean; // LOCAL PATCH: a LIVE shell found on a machine's terminal server (not opened here)
+};
+
+const LS_KEY = 'agent-hub:terminal-sessions';
+const SERVER_ID = 'aibo';
+const SYNC_URL = `${WEBUI_API_BASE_URL}/terminal-sessions/`;
+const PUSH_DEBOUNCE = 800;
+const POLL_MS = 15000;
+
+let _rev = 0; // monotonic revision of our current state
+let _applying = false; // suppress push while we apply server state
+let _ready = false; // don't push during initial hydration
+
+const load = (): { sessions: TerminalSession[]; activeId: string; rev: number } => {
+	if (!browser) return { sessions: [], activeId: '', rev: 0 };
+	try {
+		const s = JSON.parse(localStorage.getItem(LS_KEY) || '{}');
+		return {
+			sessions: Array.isArray(s.sessions) ? s.sessions : [],
+			activeId: s.activeId || '',
+			rev: Number(s.rev) || 0
+		};
+	} catch {
+		return { sessions: [], activeId: '', rev: 0 };
+	}
+};
+
+const _init = load();
+_rev = _init.rev;
+export const terminalSessions = writable<TerminalSession[]>(_init.sessions);
+export const activeTerminalId = writable<string>(_init.activeId);
+
+const persistLocal = () => {
+	if (!browser) return;
+	try {
+		localStorage.setItem(
+			LS_KEY,
+			JSON.stringify({ sessions: get(terminalSessions), activeId: get(activeTerminalId), rev: _rev })
+		);
+	} catch {}
+};
+
+const token = () => (browser ? localStorage.getItem('token') ?? '' : '');
+
+// Apply an authoritative server state without triggering a push back.
+const applyServer = (state: { sessions?: TerminalSession[]; activeId?: string; rev?: number }) => {
+	const rev = Number(state?.rev) || 0;
+	if (rev <= _rev) return; // not newer — ignore
+	_applying = true;
+	try {
+		terminalSessions.set(Array.isArray(state.sessions) ? state.sessions : []);
+		activeTerminalId.set(state.activeId || '');
+		_rev = rev;
+		persistLocal();
+	} finally {
+		_applying = false;
+	}
+};
+
+let _pushTimer: any = null;
+const schedulePush = () => {
+	if (!browser) return;
+	if (_pushTimer) clearTimeout(_pushTimer);
+	_pushTimer = setTimeout(async () => {
+		_pushTimer = null;
+		const payload = { sessions: get(terminalSessions), activeId: get(activeTerminalId), rev: _rev };
+		try {
+			const r = await fetch(SYNC_URL, {
+				method: 'PUT',
+				headers: { 'Content-Type': 'application/json', Authorization: `Bearer ${token()}` },
+				body: JSON.stringify(payload)
+			});
+			if (r.ok) applyServer(await r.json()); // adopt if the server had a newer state
+		} catch {}
+	}, PUSH_DEBOUNCE);
+};
+
+export const pullTerminalSessions = async () => {
+	if (!browser) return;
+	if (typeof document !== 'undefined' && document.hidden) return; // don't poll a backgrounded tab
+	try {
+		const r = await fetch(SYNC_URL, { headers: { Authorization: `Bearer ${token()}` } });
+		if (r.ok) applyServer(await r.json());
+	} catch {}
+};
+
+// Friendly label for a discovered shell from the server-reported {cwd, cmd}: prefer "cmd · dir"
+// (e.g. "claude · restock"), else the cwd's last segment, else a short id fallback.
+const terminalLabel = (s: any): string => {
+	const dir = s?.cwd ? String(s.cwd).replace(/\/+$/, '').split('/').pop() || String(s.cwd) : '';
+	if (s?.cmd) return dir && dir !== '~' ? `${s.cmd} · ${dir}` : String(s.cmd);
+	return dir || 'Shell ' + String(s?.id ?? '').slice(-4);
+};
+
+// LOCAL PATCH (cross-machine terminal discovery): the sync store above only lists shells opened through
+// THIS hub. But live PTYs on each machine's terminal server may have been started elsewhere (another
+// device, the machine's own UI, an agent). Ask every terminal server for its live sessions and merge
+// them in as `discovered` entries so ANY running shell on a machine shows up here — tapping one attaches
+// to the live PTY (create_session re-attaches by id). Discovered entries are display-only: they never
+// push to the sync store (guarded by _applying), and stale ones are pruned each pass.
+export const discoverSessions = async () => {
+	if (!browser) return;
+	if (typeof document !== 'undefined' && document.hidden) return;
+	const servers = get(terminalServers) ?? [];
+	const found: TerminalSession[] = [];
+	for (const srv of servers) {
+		if (!srv?.id) continue;
+		try {
+			const r = await fetch(`${WEBUI_API_BASE_URL}/terminals/${srv.id}/api/terminals/sessions`, {
+				headers: { Authorization: `Bearer ${token()}` }
+			});
+			if (!r.ok) continue;
+			const d = await r.json();
+			for (const s of d?.sessions ?? []) {
+				if (!s?.id) continue;
+				found.push({
+					id: s.id,
+					name: terminalLabel(s),
+					createdAt: Date.now(),
+					serverId: srv.id,
+					discovered: true
+				});
+			}
+		} catch {}
+	}
+	// Merge: keep everything we opened locally (discovered !== true); replace the discovered set with the
+	// freshly-found live shells, skipping ids we already track locally. Suppress the sync push.
+	_applying = true;
+	try {
+		const local = get(terminalSessions).filter((x) => !x.discovered);
+		const localIds = new Set(local.map((x) => x.id));
+		const fresh = found.filter((f) => !localIds.has(f.id));
+		terminalSessions.set([...local, ...fresh]);
+		persistLocal();
+	} finally {
+		_applying = false;
+	}
+};
+
+// React to any change: cache locally, and (once hydrated, and not mid-apply) bump rev + push.
+const onChange = () => {
+	if (!browser) return;
+	if (_ready && !_applying) {
+		_rev = Date.now();
+	}
+	persistLocal();
+	if (_ready && !_applying) schedulePush();
+};
+terminalSessions.subscribe(onChange);
+activeTerminalId.subscribe(onChange);
+
+// Resolves once the first server pull completes — so we never auto-create a shell (and clobber the
+// server's list) before we've seen what other devices already have open.
+let _hydrateResolve: (() => void) | null = null;
+const _hydrated: Promise<void> = browser ? new Promise((r) => (_hydrateResolve = r)) : Promise.resolve();
+
+const refresh = () => {
+	pullTerminalSessions();
+	discoverSessions(); // merge live shells from every machine's terminal server
+};
+
+if (browser) {
+	_ready = true;
+	// Initial hydrate from server, then keep fresh on focus + a light poll.
+	pullTerminalSessions().finally(() => {
+		_hydrateResolve?.();
+		discoverSessions();
+	});
+	window.addEventListener('focus', refresh);
+	window.addEventListener('online', refresh);
+	setInterval(refresh, POLL_MS);
+}
+
+const uid = () =>
+	'term-' + (globalThis.crypto?.randomUUID?.() ?? `${Date.now()}-${Math.random().toString(36).slice(2)}`);
+
+export const newTerminalSession = (): string => {
+	const list = get(terminalSessions);
+	const s: TerminalSession = {
+		id: uid(),
+		name: `Terminal ${list.length + 1}`,
+		createdAt: Date.now(),
+		serverId: get(selectedTerminalId) || undefined // LOCAL PATCH (E10): which machine this shell runs on
+	};
+	terminalSessions.set([...list, s]);
+	activeTerminalId.set(s.id);
+	return s.id;
+};
+
+export const closeTerminalSession = async (id: string) => {
+	if (browser) {
+		// LOCAL PATCH (E10 fix): kill the PTY on the shell's ACTUAL machine, not always aibo.
+		const srv = get(terminalSessions).find((x) => x.id === id)?.serverId || SERVER_ID;
+		try {
+			await fetch(`${WEBUI_API_BASE_URL}/terminals/${srv}/api/terminals/${id}`, {
+				method: 'DELETE',
+				headers: { Authorization: `Bearer ${token()}` }
+			});
+		} catch {}
+	}
+	const list = get(terminalSessions).filter((x) => x.id !== id);
+	terminalSessions.set(list);
+	if (get(activeTerminalId) === id) activeTerminalId.set(list[list.length - 1]?.id ?? '');
+};
+
+export const renameTerminalSession = (id: string, name: string) => {
+	terminalSessions.set(
+		get(terminalSessions).map((x) => (x.id === id ? { ...x, name: name.trim() || x.name, pinned: true } : x))
+	);
+};
+
+// Auto-title from the terminal's OSC title (cwd/command); skips user-renamed (pinned) sessions.
+export const setSessionTitle = (id: string, title: string) => {
+	const t = (title || '').trim();
+	if (!t) return;
+	terminalSessions.set(
+		get(terminalSessions).map((x) => (x.id === id && !x.pinned ? { ...x, name: t } : x))
+	);
+};
+
+// Ensure there's at least one session and a valid active one (call on the /terminal page).
+// Awaits the initial server hydrate first so we don't create a spurious shell that overwrites the
+// list another device already has open.
+export const ensureTerminalSession = async () => {
+	await _hydrated;
+	if (get(terminalSessions).length === 0) newTerminalSession();
+	const list = get(terminalSessions);
+	if (!list.find((x) => x.id === get(activeTerminalId))) activeTerminalId.set(list[0]?.id ?? '');
+};
