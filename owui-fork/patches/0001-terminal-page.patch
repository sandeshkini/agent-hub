+				autofocus on:blur={commitRename} on:keydown={(e) => e.key === 'Enter' && commitRename()} />
+		{:else}
+			<div class="text-sm font-medium truncate flex-1 min-w-0 cursor-text" title={$i18n.t('Rename')}
+				on:dblclick={startRename}>{active?.name ?? $i18n.t('Terminal')}</div>
+		{/if}
+
+		<div class="shrink-0 flex items-center text-gray-500">
+			<button class="px-1.5 py-1 rounded-lg hover:bg-gray-50 dark:hover:bg-gray-900 transition text-xs"
+				title={$i18n.t('Smaller')} on:click={() => setFont(fontSize - 1)}>A−</button>
+			<button class="px-1.5 py-1 rounded-lg hover:bg-gray-50 dark:hover:bg-gray-900 transition text-sm"
+				title={$i18n.t('Larger')} on:click={() => setFont(fontSize + 1)}>A+</button>
+			<button class="px-2 py-1 rounded-lg hover:bg-gray-50 dark:hover:bg-gray-900 transition text-xs"
+				title={$i18n.t('Reconnect')} on:click={() => (reconnectKey += 1)}>⟳</button>
+			<button
+				class="p-1 ml-0.5 rounded-lg hover:bg-gray-50 dark:hover:bg-gray-900 transition {showFiles ? 'text-gray-900 dark:text-white bg-gray-100 dark:bg-gray-850' : ''}"
+				title={$i18n.t('Files')} aria-pressed={showFiles} on:click={toggleFiles}>
+				<Folder className="size-4" />
+			</button>
+		</div>
+	</div>
+
+	<div class="flex-1 min-h-0 flex relative">
