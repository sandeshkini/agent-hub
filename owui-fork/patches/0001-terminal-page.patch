@@ -0,0 +1,112 @@
+# LOCAL PATCH (agent-hub fork): E4/E5 multi-machine node registry.
+# A faithful port of the `dispatch` hub into the OWUI backend. Each machine ("node") runs an
+# agent-hub-node bundle (adapter fleet + owui-terminal) that self-registers here on a heartbeat.
+# The registry is IN-MEMORY and stateless — rebuilt from heartbeats, exactly like dispatch:
+#   - node id = sha256(url)[:8]  (stable, deterministic)
+#   - register/heartbeat: POST /api/nodes/register  (Bearer NODE_HUB_TOKEN, machine-to-machine)
+#   - list:               GET  /api/nodes/          (browser JWT) -> nodes + computed online flag
+#   - liveness: online when last_seen <= 90s; evicted when last_seen > 1h (computed lazily on access)
+# The machine selector (frontend) reads GET /api/nodes/ to scope the model list + terminal target.
+import hashlib
+import os
+import time
+
+from fastapi import APIRouter, Depends, HTTPException, Request
+
+from open_webui.utils.auth import get_verified_user
+
+router = APIRouter()
+
+# Shared machine-to-machine secret for register/heartbeat. If unset, registration is open
+# (single-host/dev). Set NODE_HUB_TOKEN in the OWUI env to require it in production.
+NODE_HUB_TOKEN = os.environ.get("NODE_HUB_TOKEN", "").strip()
+
+OFFLINE_TTL = 90        # seconds without a heartbeat -> shown offline
+EVICT_TTL = 3600        # seconds without a heartbeat -> dropped from the registry
+
+# id -> node dict. Fields:
+#   id, label, url, api_url, token, capabilities[], models[], terminal(dict|None),
+#   version, registered_at, last_seen
+_nodes: dict = {}
+
+
+def _node_id(url: str) -> str:
+    return hashlib.sha256((url or "").encode()).hexdigest()[:8]
+
+
+def _bearer(request: Request) -> str:
+    h = request.headers.get("authorization", "")
+    return h[7:].strip() if h.lower().startswith("bearer ") else ""
+
+
+def _prune(now: float | None = None) -> None:
+    now = now or time.time()
+    for nid in [k for k, v in _nodes.items() if now - v.get("last_seen", 0) > EVICT_TTL]:
+        _nodes.pop(nid, None)
+
+
+def _view(n: dict, now: float) -> dict:
+    # Never leak the node token to browsers; expose an `online` flag instead of raw last_seen math.
+    return {
+        "id": n["id"],
+        "label": n.get("label") or n["id"],
+        "url": n.get("url"),
+        "api_url": n.get("api_url") or n.get("url"),
+        "capabilities": n.get("capabilities") or [],
+        "models": n.get("models") or [],
+        "terminal": n.get("terminal"),
+        "version": n.get("version"),
+        "online": (now - n.get("last_seen", 0)) <= OFFLINE_TTL,
+        "last_seen": int(n.get("last_seen", 0)),
+        "registered_at": int(n.get("registered_at", 0)),
+    }
+
+
+@router.post("/register")
+async def register_node(request: Request):
+    if NODE_HUB_TOKEN and _bearer(request) != NODE_HUB_TOKEN:
+        raise HTTPException(status_code=401, detail="bad node hub token")
+    try:
+        body = await request.json()
+    except Exception:
+        raise HTTPException(status_code=400, detail="invalid json")
+
+    url = (body.get("url") or "").strip()
+    if not url:
+        raise HTTPException(status_code=400, detail="url is required")
+
+    now = time.time()
+    nid = _node_id(url)
+    existing = _nodes.get(nid) or {}
+    _nodes[nid] = {
+        "id": nid,
+        "label": body.get("label") or existing.get("label") or nid,
+        "url": url,
+        "api_url": (body.get("api_url") or "").strip() or url,
+        "token": body.get("token") or existing.get("token") or "",
+        "capabilities": body.get("capabilities") or [],
+        "models": body.get("models") or [],
+        "terminal": body.get("terminal"),
+        "version": body.get("version"),
+        "registered_at": existing.get("registered_at") or now,
+        "last_seen": now,
+    }
+    _prune(now)
+    return {"id": nid, "status": "registered"}
+
+
+@router.get("/")
+async def list_nodes(user=Depends(get_verified_user)):
+    now = time.time()
+    _prune(now)
+    nodes = [_view(n, now) for n in _nodes.values()]
+    nodes.sort(key=lambda x: (not x["online"], x["label"].lower()))
+    return nodes
+
+
+@router.delete("/{node_id}")
+async def delete_node(node_id: str, user=Depends(get_verified_user)):
+    if (getattr(user, "role", None) or "") != "admin":
+        raise HTTPException(status_code=403, detail="admin only")
+    existed = _nodes.pop(node_id, None) is not None
+    return {"deleted": existed}
