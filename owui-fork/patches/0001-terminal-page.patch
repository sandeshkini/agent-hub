+			<button class="shrink-0 flex items-center gap-1 px-1 rounded-lg hover:bg-gray-50 dark:hover:bg-gray-900"
+				title={termConnected ? $i18n.t('Connected') : termConnecting ? $i18n.t('Connecting…') : $i18n.t('Disconnected — tap to reconnect')}
+				on:click={() => { if (!termConnected) xterm?.reconnect?.(); }}>
+				<span class="size-2 rounded-full {termConnected ? 'bg-green-500' : termConnecting ? 'bg-amber-500 animate-pulse' : 'bg-red-500'}"></span>
+				{#if !termConnected && !termConnecting}<span class="text-xs text-red-500">{$i18n.t('Reconnect')}</span>{/if}
