# agent-hub node front-door (E10.6)
# ONE address for a worker machine's agents + terminal, so the hub reaches everything on this node via a
# single Pangolin resource (register.mb) instead of one hostname per port. TLS is terminated upstream at
# Pangolin/Traefik, so this is plain HTTP on :8088. Bearer auth is enforced by the backends themselves
# (ADAPTER_KEY on the adapters, TERMINAL_TOKEN on the terminal) — the front-door just routes + strips the
# path prefix. Add a new agent = add one handle_path block here; no new hostname/DNS needed.
{
	admin off
	auto_https off
}

:8088 {
	# SECURITY: overwrite client-supplied forwarding headers so they can't be spoofed into backend logs.
	# (Backends auth via Bearer, not X-Forwarded, so this is defense-in-depth.)
	# NOTE: header_up is a reverse_proxy subdirective — at site level Caddy fails to start with
	# "unrecognized directive: header_up", so it must live inside each reverse_proxy block.

	# Claude adapter → /claude/v1/...  (OWUI connection base: https://register.mb.<domain>/claude/v1)
	handle_path /claude/* {
		reverse_proxy owui-claude:9212 {
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto https
		}
	}
	# OpenCode adapter → /opencode/v1/...
	handle_path /opencode/* {
		reverse_proxy owui-opencode:9213 {
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto https
		}
	}
	# Hermes adapter → /hermes/v1/...  (the brain itself is a host service on :9119; this is its adapter)
	handle_path /hermes/* {
		reverse_proxy owui-hermes:9211 {
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto https
		}
	}
	# Terminal (owui-terminal runs on the host) → /term/api/terminals/{id} (WebSocket)
	handle_path /term/* {
		reverse_proxy host.docker.internal:7681 {
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto https
		}
	}
	# Health probe for the hub's node-pin heartbeat.
	handle /health {
		respond "ok" 200
	}
	handle {
		respond "agent-hub node front-door" 404
	}
}
