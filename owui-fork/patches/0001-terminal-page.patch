+<script lang="ts">
+	// LOCAL PATCH (agent-hub fork): E2 Inbox with real-time smart summaries. Polls /api/inbox (chats +
+	// unread/running state + LLM one-line summaries from local llama3.2:3b, regenerated when a chat
+	// changes) and lists terminal sessions from the shared store. Summaries update live as chats change.
+	import { onMount, onDestroy, getContext } from 'svelte';
+	import { goto } from '$app/navigation';
+	import { WEBUI_API_BASE_URL } from '$lib/constants';
+	import { showSidebar, mobile } from '$lib/stores';
+	import { terminalSessions, activeTerminalId } from '$lib/utils/agentTerminals';
+	// LOCAL PATCH (E10): machine attribution + filter in the inbox.
+	import { selectedNodeId, nodes, hubNode, machineIdForModel, machineForModel, machineForTerminal } from '$lib/utils/machineSelector';
+	import MachineChip from '$lib/components/layout/Sidebar/MachineChip.svelte';
+	import Spinner from '$lib/components/common/Spinner.svelte';
+	import MenuLines from '$lib/components/icons/MenuLines.svelte';
+
+	const i18n = getContext('i18n');
+	let loaded = false;
+	let chats: any[] = [];
+	let timer: ReturnType<typeof setInterval> | null = null;
+
+	const load = async () => {
+		try {
+			const r = await fetch(`${WEBUI_API_BASE_URL}/inbox/`, {
+				headers: { Authorization: `Bearer ${localStorage.getItem('token') ?? ''}` }
+			});
+			if (r.ok) chats = (await r.json()) || [];
+		} catch (e) {}
+		loaded = true;
+	};
+
+	onMount(() => {
+		load();
+		// live updates: re-poll while the tab is visible so summaries/state refresh in real time
+		timer = setInterval(() => {
+			if (typeof document === 'undefined' || document.visibilityState === 'visible') load();
+		}, 3000);
+	});
+	onDestroy(() => {
+		if (timer) clearInterval(timer);
+	});
+
+	const st = (c: any) =>
+		c.active ? 'running' : (c.updated_at ?? 0) > (c.last_read_at ?? 0) ? 'unread' : 'read';
+
+	// LOCAL PATCH (E10): scope to the selected machine (null = All machines). Attribution by model.
+	$: mchats = $selectedNodeId
+		? chats.filter((c) => !c?.model_id || machineIdForModel(c?.model_id, $nodes, $hubNode) === $selectedNodeId)
+		: chats;
+	$: needs = mchats.filter((c) => st(c) !== 'read');
+	$: recent = mchats.filter((c) => st(c) === 'read');
+
+	const chatMachine = (c: any) =>
+		machineForModel(c?.model_id, $nodes) ??
+		($nodes.find((n) => n.id === machineIdForModel(c?.model_id, $nodes, $hubNode)) ?? null);
+	const termMachine = (t: any) => machineForTerminal(t?.serverId, $nodes) ?? $hubNode;
+	$: mterminals = $selectedNodeId
+		? $terminalSessions.filter((t) => (termMachine(t)?.id ?? null) === $selectedNodeId)
+		: $terminalSessions;
+
+	const rel = (t: number) => {
+		if (!t) return '';
+		const s = Math.floor(Date.now() / 1000) - t;
+		if (s < 60) return 'now';
+		if (s < 3600) return `${Math.floor(s / 60)}m`;
+		if (s < 86400) return `${Math.floor(s / 3600)}h`;
+		return `${Math.floor(s / 86400)}d`;
+	};
+	const dot = (state: string) =>
+		state === 'running'
+			? 'bg-green-500 animate-pulse'
+			: state === 'unread'
+				? 'bg-blue-500'
+				: 'bg-gray-300 dark:bg-gray-700';
+	const sub = (c: any) => c.summary || c.snippet || '';
+</script>
+
+<svelte:head><title>{$i18n.t('Inbox')}</title></svelte:head>
+
+<div class="h-full w-full flex flex-col overflow-hidden">
+	<div class="flex items-center gap-2 px-3 py-2.5 border-b border-gray-50 dark:border-gray-850 shrink-0">
+		{#if $mobile && !$showSidebar}
+			<button class="p-1.5 rounded-lg hover:bg-gray-50 dark:hover:bg-gray-900" aria-label="Menu"
+				on:click={() => showSidebar.set(true)}><MenuLines className="size-5" /></button>
+		{/if}
+		<div class="text-base font-medium">{$i18n.t('Inbox')}</div>
+		{#if needs.length}<div class="text-xs px-1.5 py-0.5 rounded-full bg-blue-500/10 text-blue-500">{needs.length}</div>{/if}
+	</div>
+
+	{#if !loaded}
+		<div class="flex-1 flex items-center justify-center"><Spinner /></div>
+	{:else}
+		<div class="flex-1 overflow-y-auto px-2 py-2 max-w-3xl w-full mx-auto">
+			{#if needs.length}
+				<div class="px-2 pt-1 pb-1 text-xs font-medium text-gray-400 uppercase tracking-wide">{$i18n.t('Needs attention')}</div>
+				{#each needs as c (c.id)}
+					<button class="w-full text-left flex items-start gap-2.5 rounded-xl px-2.5 py-2 hover:bg-gray-50 dark:hover:bg-gray-900 transition"
+						on:click={() => goto(`/c/${c.id}`)}>
+						<span class="mt-1.5 size-2 shrink-0 rounded-full {dot(st(c))}"></span>
+						<span class="flex-1 min-w-0">
+							<span class="flex items-center gap-2">
+								<span class="truncate text-sm font-medium">{c.title || $i18n.t('New Chat')}</span>
+								<span class="ml-auto shrink-0 text-[11px] text-gray-400">{rel(c.updated_at)}</span>
+							</span>
+							{#if sub(c)}<span class="block break-words text-xs text-gray-500 dark:text-gray-400 mt-0.5">{sub(c)}</span>{/if}
+							{#if !$selectedNodeId && $nodes.length > 1 && chatMachine(c)?.label}<span class="mt-1 inline-block"><MachineChip label={chatMachine(c).label} online={chatMachine(c)?.online ?? true} /></span>{/if}
+						</span>
+					</button>
+				{/each}
+			{/if}
+
+			{#if mterminals.length}
+				<div class="px-2 pt-3 pb-1 text-xs font-medium text-gray-400 uppercase tracking-wide">{$i18n.t('Terminals')}</div>
+				{#each mterminals as t (t.id)}
+					<button class="w-full text-left flex items-center gap-2.5 rounded-xl px-2.5 py-2 hover:bg-gray-50 dark:hover:bg-gray-900 transition"
+						on:click={() => { activeTerminalId.set(t.id); goto('/terminal'); }}>
+						<span class="size-2 shrink-0 rounded-full bg-green-500"></span>
+						<span class="truncate text-sm flex-1 min-w-0">{t.name}</span>
+						{#if !$selectedNodeId && $nodes.length > 1 && termMachine(t)?.label}<MachineChip label={termMachine(t).label} online={termMachine(t)?.online ?? true} />{/if}
+						<span class="shrink-0 text-[11px] text-gray-400">shell</span>
+					</button>
+				{/each}
+			{/if}
+
+			<div class="px-2 pt-3 pb-1 text-xs font-medium text-gray-400 uppercase tracking-wide">{$i18n.t('Recent')}</div>
+			{#each recent as c (c.id)}
+				<button class="w-full text-left flex items-start gap-2.5 rounded-xl px-2.5 py-2 hover:bg-gray-50 dark:hover:bg-gray-900 transition"
+					on:click={() => goto(`/c/${c.id}`)}>
+					<span class="mt-1.5 size-2 shrink-0 rounded-full {dot('read')}"></span>
+					<span class="flex-1 min-w-0">
+						<span class="flex items-center gap-2">
+							<span class="truncate text-sm">{c.title || $i18n.t('New Chat')}</span>
+							<span class="ml-auto shrink-0 text-[11px] text-gray-400">{rel(c.updated_at)}</span>
+						</span>
+						{#if sub(c)}<span class="block break-words text-xs text-gray-500 dark:text-gray-400 mt-0.5">{sub(c)}</span>{/if}
+					</span>
+				</button>
+			{/each}
+
+			{#if chats.length === 0}
+				<div class="text-center text-sm text-gray-400 py-10">{$i18n.t('Nothing here yet.')}</div>
+			{/if}
+		</div>
+	{/if}
+</div>
