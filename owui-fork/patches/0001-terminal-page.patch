+<script lang="ts">
+	// LOCAL PATCH (agent-hub fork, E7): renders a Claude AskUserQuestion as interactive option cards
+	// and POSTs the user's choice to /api/agent/answer (→ owui-claude /answer → resolves the turn).
+	import { getContext } from 'svelte';
+	import { WEBUI_API_BASE_URL } from '$lib/constants';
+	import { removeQuestion } from '$lib/utils/agentQuestions';
+
+	const i18n = getContext('i18n');
+
+	export let chatId: string;
+	export let item: { id: string; questions: any[] };
+
+	let submitting = false;
+	// selections[qIdx] = string (single) | string[] (multi)
+	let selections: Record<number, any> = {};
+
+	const qText = (q: any) => q?.question ?? q?.header ?? '';
+	const isMulti = (q: any) => !!q?.multiSelect;
+
+	const toggle = (qi: number, label: string, multi: boolean) => {
+		if (multi) {
+			const cur: string[] = Array.isArray(selections[qi]) ? selections[qi] : [];
+			selections[qi] = cur.includes(label) ? cur.filter((l) => l !== label) : [...cur, label];
+		} else {
+			selections[qi] = label;
+		}
+		selections = selections;
+	};
+	const isSel = (qi: number, label: string) => {
+		const v = selections[qi];
+		return Array.isArray(v) ? v.includes(label) : v === label;
+	};
+
+	const ready = () =>
+		(item.questions ?? []).every((_, qi) => {
+			const v = selections[qi];
+			return Array.isArray(v) ? v.length > 0 : !!v;
+		});
+
+	const submit = async () => {
+		if (submitting || !ready()) return;
+		submitting = true;
+		const answers: Record<string, any> = {};
+		(item.questions ?? []).forEach((q, qi) => {
+			answers[qText(q)] = selections[qi];
+		});
+		try {
+			const r = await fetch(`${WEBUI_API_BASE_URL}/agent/answer`, {
+				method: 'POST',
+				headers: {
+					'Content-Type': 'application/json',
+					Authorization: `Bearer ${localStorage.getItem('token') ?? ''}`
+				},
+				body: JSON.stringify({ id: item.id, answers })
+			});
+			if (!r.ok) throw new Error(`answer POST ${r.status}`);
+			removeQuestion(chatId, item.id); // clear the card ONLY once the agent actually received the answer
+		} catch (e) {
+			// CONV-FLOW (#10): keep the card + let the user retry instead of silently losing the answer
+			// (fetch doesn't throw on 4xx/5xx, and the old code removed the card unconditionally).
+			console.error('[AgentQuestion] answer failed:', e);
+			submitting = false;
+		}
+	};
+</script>
+
+<div class="my-2 rounded-2xl border border-gray-100 dark:border-gray-800 bg-gray-50 dark:bg-gray-900 p-3">
+	<div class="text-xs font-medium text-gray-500 mb-2 flex items-center gap-1.5">
+		<span class="size-1.5 rounded-full bg-blue-500 animate-pulse"></span>
+		{$i18n.t('The agent needs your input')}
+	</div>
+
+	{#each item.questions ?? [] as q, qi}
+		<div class="mb-3 last:mb-0">
+			{#if q?.header}<div class="text-[11px] uppercase tracking-wide text-gray-400 mb-0.5">{q.header}</div>{/if}
+			<div class="text-sm whitespace-pre-wrap max-h-80 overflow-y-auto mb-1.5">{qText(q)}</div>
+			<div class="flex flex-col gap-1.5">
+				{#each q?.options ?? [] as opt}
+					<button
+						type="button"
+						class="text-left px-3 py-2 rounded-xl border text-sm transition
+							{isSel(qi, opt.label)
+								? 'border-blue-500 bg-blue-50 dark:bg-blue-950/40'
+								: 'border-gray-200 dark:border-gray-800 hover:bg-gray-100 dark:hover:bg-gray-850'}"
+						on:click={() => toggle(qi, opt.label, isMulti(q))}
+					>
+						<div class="font-medium">{opt.label}</div>
+						{#if opt.description}<div class="text-xs text-gray-500 mt-0.5">{opt.description}</div>{/if}
+					</button>
+				{/each}
+			</div>
+		</div>
+	{/each}
+
+	<div class="flex justify-end mt-2">
+		<button
+			type="button"
+			class="px-3 py-1.5 rounded-xl text-sm font-medium bg-black text-white dark:bg-white dark:text-black disabled:opacity-40 transition"
+			disabled={submitting || !ready()}
+			on:click={submit}
+		>
+			{submitting ? $i18n.t('Sending...') : $i18n.t('Submit')}
+		</button>
+	</div>
+</div>
